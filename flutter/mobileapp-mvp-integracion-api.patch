+  }
+}
+
+class _WaitingCycle extends StatelessWidget {
+  const _WaitingCycle();
+
+  @override
+  Widget build(BuildContext context) {
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,

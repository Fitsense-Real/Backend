diff --git a/lib/features/plan/domain/services/adaptation_messages.dart b/lib/features/plan/domain/services/adaptation_messages.dart
new file mode 100644
index 0000000..5fab4c7
--- /dev/null
+++ b/lib/features/plan/domain/services/adaptation_messages.dart
@@ -0,0 +1,79 @@
+import '../../data/models/adaptation_outcome.dart';
+
+/// Tipo de mensaje para el usuario, derivado SOLO de `AdaptationOutcome.resultado`.
+enum AdaptationMessageKind { kept, adjusted, safetySubstitution, notFeasible, progression, unknown }
+
+class AdaptationMessage {
+  final AdaptationMessageKind kind;
+  final String title;
+
+  /// Detalle técnico del backend (`resultado` y `motivos`), plegado por defecto.
+  final List<String> technicalDetail;
+
+  const AdaptationMessage(this.kind, this.title, this.technicalDetail);
+
+  bool get isNotFeasible => kind == AdaptationMessageKind.notFeasible;
+}
+
+/// Mensajes acordados (orden de cierre del backend, fase 5). La app no infiere
+/// causas médicas ni inventa códigos de motivo: el motivo técnico se muestra tal
+/// cual, aparte.
+class AdaptationMessages {
+  AdaptationMessages._();
+
+  static const kept = 'Tu plan se mantiene esta semana';
+  static const adjusted = 'Se ajustó una sesión debido a una dificultad registrada';
+  static const safety = 'Se sustituyó un ejercicio por una restricción de seguridad';
+  static const notFeasible = 'No fue posible preparar una nueva rutina que cumpla todas tus restricciones';
+  static const progression = 'Tu plan avanza según lo que registraste';
+  static const notFeasibleHelp =
+      'Tus restricciones se mantienen. Puedes seguir consultando tu historial y contactar con el equipo del estudio.';
+
+  static AdaptationMessage of(AdaptationOutcome outcome) {
+    final detail = ['Resultado: ${outcome.resultado}', ...outcome.motivos];
+    return AdaptationMessage(kindOf(outcome.resultado), titleOf(kindOf(outcome.resultado), outcome.resultado), detail);
+  }
+
+  static AdaptationMessageKind kindOf(String resultado) {
+    switch (resultado) {
+      case 'ADAPTACION_APLICADA':
+        return AdaptationMessageKind.adjusted;
+      case 'REGENERACION_SEGURA_SUSTITUCION':
+      case 'REGENERACION_SEGURA_REGLAS':
+        return AdaptationMessageKind.safetySubstitution;
+      case 'NO_FACTIBLE':
+      case 'NO_FACTIBLE_POR_SEGURIDAD':
+        return AdaptationMessageKind.notFeasible;
+      case 'PROGRESION_DEL_BACKEND':
+        return AdaptationMessageKind.progression;
+      case 'CONSERVACION_DELIBERADA':
+      case 'SIN_CAMBIOS_VALIDOS':
+      case 'ACORTAMIENTO_IMPOSIBLE':
+      case 'REPROGRAMACION_IMPOSIBLE':
+      case 'ADAPTACION_IMPOSIBLE':
+      case 'RESPALDO_PROPUESTA_IA_INVALIDA':
+      case 'RESPALDO_SIN_IA':
+      case 'SIN_ADAPTACION':
+        return AdaptationMessageKind.kept;
+      default:
+        return AdaptationMessageKind.unknown;
+    }
+  }
+
+  static String titleOf(AdaptationMessageKind kind, String resultado) {
+    switch (kind) {
+      case AdaptationMessageKind.kept:
+        return kept;
+      case AdaptationMessageKind.adjusted:
+        return adjusted;
+      case AdaptationMessageKind.safetySubstitution:
+        return safety;
+      case AdaptationMessageKind.notFeasible:
+        return notFeasible;
+      case AdaptationMessageKind.progression:
+        return progression;
+      case AdaptationMessageKind.unknown:
+        return 'Tu plan se actualizó';
+    }
+  }
+}
diff --git a/lib/features/plan/domain/services/plan_status.dart b/lib/features/plan/domain/services/plan_status.dart
new file mode 100644

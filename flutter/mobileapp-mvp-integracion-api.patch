+/// Textos en español de los códigos que devuelve el backend. Un código
+/// desconocido se muestra tal cual (nunca se inventa un significado).
+class FitSenseLabels {
+  FitSenseLabels._();
+
+  static const goalTypes = {
+    'LOSE_WEIGHT': 'Perder peso',
+    'GAIN_MUSCLE': 'Ganar músculo',
+    'INCREASE_STRENGTH': 'Aumentar fuerza',
+    'GENERAL_FITNESS': 'Condición física general',
+  };
+
+  static const fitnessLevels = {
+    'BEGINNER': 'Principiante',
+    'INTERMEDIATE': 'Intermedio',
+    'ADVANCED': 'Avanzado',
+  };
+
+  static const trainingLocations = {
+    'HOME': 'En casa',
+    'GYM': 'En el gimnasio',
+    'MIXED': 'Mixto',
+  };
+
+  static const biologicalSex = {
+    'FEMALE': 'Femenino',
+    'MALE': 'Masculino',
+    'OTHER': 'Otro',
+  };
+
+  /// ISO-8601: 1 = lunes … 7 = domingo (igual que `availableDays`).
+  static const weekdays = {
+    1: 'Lunes',
+    2: 'Martes',
+    3: 'Miércoles',
+    4: 'Jueves',
+    5: 'Viernes',
+    6: 'Sábado',
+    7: 'Domingo',
+  };
+
+  static const skipReasons = {
+    'LACK_OF_TIME': 'Falta de tiempo',
+    'FATIGUE': 'Cansancio',
+    'LACK_OF_MOTIVATION': 'Falta de motivación',
+    'TOO_DIFFICULT': 'Demasiado difícil',
+    'PAIN_OR_DISCOMFORT': 'Dolor o molestia',
+    'SCHEDULE_CHANGE': 'Cambio de horario',
+    'OTHER': 'Otro motivo',
+  };
+
+  static const lackOfTimeContexts = {
+    'IMPREVISTO': 'Fue un imprevisto puntual',
+    'SIN_TIEMPO_ESE_DIA': 'Ese día no tuve ningún momento',
+    'MENOS_TIEMPO_HABITUAL': 'Suelo tener menos tiempo para este entrenamiento',
+  };
+
+  static const workoutStatus = {
+    'SCHEDULED': 'Programada',
+    'IN_PROGRESS': 'En curso',
+    'COMPLETED': 'Completada',
+    'PARTIAL': 'Parcial',
+    'SKIPPED': 'Omitida',
+    'REPLACED': 'Reemplazada',
+  };
+
+  static const sessionStatus = {
+    'IN_PROGRESS': 'En curso',
+    'COMPLETED': 'Completada',
+    'PARTIAL': 'Parcial',
+    'ABANDONED': 'Abandonada',
+  };
+
+  static String of(Map<Object, String> labels, Object? code) =>
+      code == null ? '—' : (labels[code] ?? code.toString());
+}
diff --git a/lib/shared/widgets/fs_async_view.dart b/lib/shared/widgets/fs_async_view.dart
new file mode 100644
index 0000000..1114273
--- /dev/null

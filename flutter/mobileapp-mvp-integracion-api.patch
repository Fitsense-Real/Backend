@@ -0,0 +1,43 @@
+import 'package:dio/dio.dart';
+
+import '../../../../core/api/api_constants.dart';
+import '../../../../core/api/api_exception.dart';
+import '../models/user_profile.dart';
+
+class ProfileRemoteDataSource {
+  final Dio _dio;
+
+  const ProfileRemoteDataSource(this._dio);
+
+  /// `null` si el usuario todavía no tiene perfil (404).
+  Future<UserProfile?> getProfile() async {
+    try {
+      return await guardApi(() async {
+        final r = await _dio.get(ApiConstants.profile);
+        return UserProfile.fromJson(r.data as Map<String, dynamic>);
+      });
+    } on ApiException catch (e) {
+      if (e.isNotFound) return null;
+      rethrow;
+    }
+  }
+
+  /// 201. Un 422 trae el rango de minutos del objetivo en `message`.
+  Future<UserProfile> createProfile(ProfileRequest request) => guardApi(() async {
+        final r = await _dio.post(ApiConstants.profile, data: request.toJson(forCreate: true));
+        return UserProfile.fromJson(r.data as Map<String, dynamic>);
+      });
+
+  /// Solo antes del primer plan; después el backend responde 422 (perfil congelado).
+  Future<UserProfile> updateProfile(ProfileRequest request) => guardApi(() async {
+        final r = await _dio.put(ApiConstants.profile, data: request.toJson(forCreate: false));
+        return UserProfile.fromJson(r.data as Map<String, dynamic>);
+      });
+
+  Future<List<EquipmentType>> equipmentTypes() => guardApi(() async {
+        final r = await _dio.get(ApiConstants.equipmentTypes);
+        final list = (r.data as List).map((e) => EquipmentType.fromJson(e as Map<String, dynamic>)).toList()
+          ..sort((a, b) => a.displayOrder.compareTo(b.displayOrder));
+        return list;
+      });
+}

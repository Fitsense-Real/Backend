diff --git a/test/integration/backend_flow_test.dart b/test/integration/backend_flow_test.dart
new file mode 100644
index 0000000..e81bafe
--- /dev/null
+++ b/test/integration/backend_flow_test.dart
@@ -0,0 +1,127 @@
+// Prueba de integración REAL contra un backend FitSense local (nunca Neon ni Railway).
+//
+// Se omite salvo que se indique la URL:
+//   flutter test test/integration --dart-define=FITSENSE_IT_BASE_URL=http://localhost:8080/api/v1
+//
+// Recorre la primera ruta del MVP: registro → perfil → generación → visualización →
+// registro de entrenamiento (con dolor) → omisión con motivo → consulta de adherencia.
+// Crea un usuario nuevo con un correo de dominio reservado (.invalid).
+import 'package:dio/dio.dart';
+import 'package:fitsense_mobile/core/api/api_exception.dart';
+import 'package:fitsense_mobile/core/api/dio_client.dart';
+import 'package:fitsense_mobile/features/authentication/data/datasource/auth_remote_datasource.dart';
+import 'package:fitsense_mobile/features/authentication/data/repositories/auth_repository_impl.dart';
+import 'package:fitsense_mobile/features/plan/data/datasource/plan_remote_datasource.dart';
+import 'package:fitsense_mobile/features/profile/data/datasource/profile_remote_datasource.dart';
+import 'package:fitsense_mobile/features/profile/data/models/user_profile.dart';
+import 'package:fitsense_mobile/features/progress/data/datasource/progress_remote_datasource.dart';
+import 'package:fitsense_mobile/features/workout/data/datasource/workout_remote_datasource.dart';
+import 'package:fitsense_mobile/features/workout/data/models/workout_session.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+const baseUrl = String.fromEnvironment('FITSENSE_IT_BASE_URL');
+
+void main() {
+  final skip = baseUrl.isEmpty ? 'Sin FITSENSE_IT_BASE_URL: no hay backend local configurado' : null;
+
+  test('primera ruta del MVP contra el backend local', () async {
+    FlutterSecureStorage.setMockInitialValues({});
+    final Dio dio = DioClient.create(baseUrl: baseUrl);
+    final auth = AuthRepositoryImpl(AuthRemoteDataSource(dio));
+    final profile = ProfileRemoteDataSource(dio);
+    final plan = PlanRemoteDataSource(dio);
+    final workout = WorkoutRemoteDataSource(dio);
+    final progress = ProgressRemoteDataSource(dio);
+
+    // 1. Registro (consentimiento explícito) → login → users/me.
+    final email = 'flutter-it-${DateTime.now().millisecondsSinceEpoch}@pruebas.invalid';
+    final user = await auth.register(
+      firstName: 'Prueba',
+      lastName: 'Flutter',
+      email: email,
+      password: 'ClaveSegura123',
+      acceptsStudyParticipation: true,
+    );
+    expect(user.email, email);
+
+    // 2. Perfil: no existe → 404 → null.
+    expect(await profile.getProfile(), isNull);
+
+    // 3. El backend decide el rango de minutos por objetivo (P-01): 422 con el rango.
+    ProfileRequest request(int minutes) => ProfileRequest(
+          birthDate: DateTime(1994, 3, 1),
+          biologicalSex: 'FEMALE',
+          heightCm: 165,
+          currentWeightKg: 62,
+          fitnessLevel: 'BEGINNER',
+          goalType: 'GENERAL_FITNESS',
+          goalText: 'Prueba de integración Flutter',
+          trainingLocation: 'HOME',
+          availableDays: [1, 3, 5],
+          sessionMinutes: minutes,
+          equipmentCodes: ['body weight', 'dumbbell'],
+        );
+    await expectLater(
+      profile.createProfile(request(15)),
+      throwsA(isA<ApiException>().having((e) => e.statusCode, 'status', 422).having((e) => e.message, 'message',
+          contains('GENERAL_FITNESS'))),
+    );
+    final created = await profile.createProfile(request(45));
+    expect(created.availableDays, [1, 3, 5]);
+    expect((await profile.equipmentTypes()), isNotEmpty);
+
+    // 4. Generación y visualización.
+    expect(await plan.current(), isNull);
+    final generated = await plan.generate();
+    final current = (await plan.current())!;
+    expect(current.planId, generated.planId);
+    expect(current.workouts, isNotEmpty);
+    expect(current.workouts.expand((w) => w.exercises).every((e) => e.doseText.isNotEmpty), isTrue);
+    expect(await plan.plans(), hasLength(1));
+    expect(await plan.adaptations(), isEmpty);
+
+    // 5. Perfil congelado tras el primer plan.
+    await expectLater(profile.updateProfile(request(45)),
+        throwsA(isA<ApiException>().having((e) => e.statusCode, 'status', 422)));
+
+    // 6. Entrenamiento: iniciar, registrar (uno con dolor), terminar con RPE.
+    final first = current.workouts.first;
+    final session = await workout.start(first.plannedWorkoutId);
+    expect(session.isInProgress, isTrue);
+    expect((await workout.current())?.sessionId, session.sessionId);
+    final exercises = first.exercises;
+    await workout.record(session.sessionId, exercises.first.plannedExerciseId,
+        const RecordExerciseRequest(actualSets: 0, skipReason: 'PAIN_OR_DISCOMFORT'));
+    for (final e in exercises.skip(1)) {
+      await workout.record(
+        session.sessionId,
+        e.plannedExerciseId,
+        RecordExerciseRequest(
+          actualSets: e.plannedSets,
+          actualRepsTotal: e.isDuration ? null : (e.plannedReps ?? 0) * (e.plannedSets ?? 1),
+          actualDurationSeconds: e.isDuration ? e.plannedDurationSeconds : null,
+        ),
+      );
+    }
+    final finished = await workout.finish(session.sessionId, const FinishSessionRequest(sessionRpe: 6, satisfaction: 4));
+    expect(finished.status, isNot('IN_PROGRESS'));
+    expect(finished.recordFor(exercises.first.plannedExerciseId)!.hadPain, isTrue);
+    expect(await workout.current(), isNull);
+
+    // 7. Omitir otra sesión con motivo y contexto.
+    if (current.workouts.length > 1) {
+      await workout.skip(
+        current.workouts[1].plannedWorkoutId,
+        const SkipWorkoutRequest(reason: 'LACK_OF_TIME', lackOfTimeContext: 'IMPREVISTO'),
+      );
+      final after = (await plan.current())!;
+      expect(after.workoutById(current.workouts[1].plannedWorkoutId)!.status, 'SKIPPED');
+    }
+
+    // 8. Seguimiento: las métricas y las exclusiones existen al cerrar la semana;
+    //    antes, las listas se leen sin error (vacías o con semanas anteriores).
+    expect(await progress.weeklyMetrics(), isA<List>());
+    expect(await progress.painExclusions(), isA<List>());
+  }, skip: skip, timeout: const Timeout(Duration(minutes: 2)));
+}

+import 'package:dio/dio.dart';
+
+import '../../../../core/api/api_constants.dart';
+import '../../../../core/api/api_exception.dart';
+import '../models/progress_models.dart';
+
+class ProgressRemoteDataSource {
+  final Dio _dio;
+
+  const ProgressRemoteDataSource(this._dio);
+
+  Future<List<WeeklyMetrics>> weeklyMetrics() => guardApi(() async {
+        final r = await _dio.get(ApiConstants.weeklyMetrics);
+        return ((r.data as List?) ?? const [])
+            .map((m) => WeeklyMetrics.fromJson(m as Map<String, dynamic>))
+            .toList();
+      });
+
+  Future<List<PainExclusion>> painExclusions() => guardApi(() async {
+        final r = await _dio.get(ApiConstants.painExclusions);
+        return ((r.data as List?) ?? const [])
+            .map((p) => PainExclusion.fromJson(p as Map<String, dynamic>))
+            .toList();
+      });
+
+  /// Única vía de reincorporación: `confirmNoPain` debe ser `true` y lo decide el usuario.
+  Future<void> reactivate(int exerciseId, {required bool confirmNoPain, String? comment}) => guardApi(() async {
+        await _dio.post(
+          ApiConstants.painReactivation(exerciseId),
+          data: {
+            'confirmNoPain': confirmNoPain,
+            if (comment != null && comment.trim().isNotEmpty) 'comment': comment.trim(),
+          },
+        );
+      });
+}

+  const PlanRemoteDataSource(this._dio);
+
+  /// 201. 422 si ya hay un plan activo, si falta el perfil o si no hay semana válida.
+  Future<WeeklyPlan> generate() => guardApi(() async {
+        final r = await _dio.post(ApiConstants.planGenerate);
+        return WeeklyPlan.fromJson(r.data as Map<String, dynamic>);
+      });
+
+  /// `null` si no hay plan activo (404).
+  Future<WeeklyPlan?> current() async {
+    try {
+      return await guardApi(() async {
+        final r = await _dio.get(ApiConstants.planCurrent);
+        return WeeklyPlan.fromJson(r.data as Map<String, dynamic>);
+      });
+    } on ApiException catch (e) {
+      if (e.isNotFound) return null;
+      rethrow;
+    }
+  }
+
+  Future<WeeklyPlan> byId(int planId) => guardApi(() async {
+        final r = await _dio.get(ApiConstants.planById(planId));
+        return WeeklyPlan.fromJson(r.data as Map<String, dynamic>);
+      });
+
+  Future<List<PlanSummary>> plans() => guardApi(() async {
+        final r = await _dio.get(ApiConstants.plans);
+        return (r.data as List).map((p) => PlanSummary.fromJson(p as Map<String, dynamic>)).toList();
+      });
+
+  /// Todos los ciclos, publicados o no (un NO_FACTIBLE no publica plan).
+  Future<List<AdaptationOutcome>> adaptations() => guardApi(() async {
+        final r = await _dio.get(ApiConstants.planAdaptations);
+        return ((r.data as List?) ?? const [])
+            .map((a) => AdaptationOutcome.fromJson(a as Map<String, dynamic>))
+            .toList();
+      });
+}

@@ -0,0 +1,182 @@
+/// `UserProfileResource` de `GET /users/me/profile`.
+class UserProfile {
+  final int userId;
+  final DateTime birthDate;
+  final int? age;
+  final String? biologicalSex;
+  final double heightCm;
+  final double currentWeightKg;
+  final double? targetWeightKg;
+  final String fitnessLevel;
+  final String goalType;
+  final String goalText;
+  final String trainingLocation;
+  final int daysPerWeek;
+  final List<int> availableDays;
+  final int sessionMinutes;
+  final List<String> equipmentCodes;
+  final List<int> blockedExerciseIds;
+  final String? healthNotes;
+  final bool allowHighImpact;
+  final bool allowFloorExercises;
+  final bool allowKneelingExercises;
+  final bool allowHangingExercises;
+  final bool allowOverheadExercises;
+
+  const UserProfile({
+    required this.userId,
+    required this.birthDate,
+    this.age,
+    this.biologicalSex,
+    required this.heightCm,
+    required this.currentWeightKg,
+    this.targetWeightKg,
+    required this.fitnessLevel,
+    required this.goalType,
+    required this.goalText,
+    required this.trainingLocation,
+    required this.daysPerWeek,
+    required this.availableDays,
+    required this.sessionMinutes,
+    required this.equipmentCodes,
+    required this.blockedExerciseIds,
+    this.healthNotes,
+    this.allowHighImpact = true,
+    this.allowFloorExercises = true,
+    this.allowKneelingExercises = true,
+    this.allowHangingExercises = true,
+    this.allowOverheadExercises = true,
+  });
+
+  factory UserProfile.fromJson(Map<String, dynamic> json) {
+    return UserProfile(
+      userId: (json['userId'] as num).toInt(),
+      birthDate: DateTime.parse(json['birthDate'] as String),
+      age: (json['age'] as num?)?.toInt(),
+      biologicalSex: json['biologicalSex'] as String?,
+      heightCm: (json['heightCm'] as num).toDouble(),
+      currentWeightKg: (json['currentWeightKg'] as num).toDouble(),
+      targetWeightKg: (json['targetWeightKg'] as num?)?.toDouble(),
+      fitnessLevel: json['fitnessLevel'] as String,
+      goalType: json['goalType'] as String,
+      goalText: (json['goalText'] as String?) ?? '',
+      trainingLocation: json['trainingLocation'] as String,
+      daysPerWeek: (json['daysPerWeek'] as num).toInt(),
+      availableDays: _ints(json['availableDays']),
+      sessionMinutes: (json['sessionMinutes'] as num).toInt(),
+      equipmentCodes: ((json['equipmentCodes'] as List?) ?? const []).cast<String>(),
+      blockedExerciseIds: _ints(json['blockedExerciseIds']),
+      healthNotes: json['healthNotes'] as String?,
+      allowHighImpact: (json['allowHighImpact'] as bool?) ?? true,
+      allowFloorExercises: (json['allowFloorExercises'] as bool?) ?? true,
+      allowKneelingExercises: (json['allowKneelingExercises'] as bool?) ?? true,
+      allowHangingExercises: (json['allowHangingExercises'] as bool?) ?? true,
+      allowOverheadExercises: (json['allowOverheadExercises'] as bool?) ?? true,
+    );
+  }
+
+  static List<int> _ints(Object? v) => ((v as List?) ?? const []).map((e) => (e as num).toInt()).toList();
+}
+
+/// Cuerpo de `POST` (crear) y `PUT` (actualizar) `/users/me/profile`.
+///
+/// Los rangos de minutos por objetivo los decide el backend (P-01): la app
+/// solo aplica los límites de formato (15–180) y muestra el error 422 del
+/// servidor con el rango exacto del objetivo elegido.
+class ProfileRequest {
+  final DateTime? birthDate;
+  final String? biologicalSex;
+  final double heightCm;
+  final double currentWeightKg;
+  final double? targetWeightKg;
+  final String fitnessLevel;
+  final String goalType;
+  final String goalText;
+  final String trainingLocation;
+  final List<int> availableDays;
+  final int sessionMinutes;
+  final List<String> equipmentCodes;
+  final String? healthNotes;
+  final bool allowHighImpact;
+  final bool allowFloorExercises;
+  final bool allowKneelingExercises;
+  final bool allowHangingExercises;
+  final bool allowOverheadExercises;
+
+  const ProfileRequest({
+    this.birthDate,
+    this.biologicalSex,
+    required this.heightCm,
+    required this.currentWeightKg,
+    this.targetWeightKg,
+    required this.fitnessLevel,
+    required this.goalType,
+    required this.goalText,
+    required this.trainingLocation,
+    required this.availableDays,
+    required this.sessionMinutes,
+    required this.equipmentCodes,
+    this.healthNotes,
+    this.allowHighImpact = true,
+    this.allowFloorExercises = true,
+    this.allowKneelingExercises = true,
+    this.allowHangingExercises = true,
+    this.allowOverheadExercises = true,
+  });
+
+  /// [forCreate] incluye `birthDate` (solo se declara al crear).
+  Map<String, dynamic> toJson({required bool forCreate}) {
+    final days = [...availableDays]..sort();
+    return {
+      if (forCreate && birthDate != null) 'birthDate': _date(birthDate!),
+      if (biologicalSex != null) 'biologicalSex': biologicalSex,
+      'heightCm': heightCm,
+      'currentWeightKg': currentWeightKg,
+      if (targetWeightKg != null) 'targetWeightKg': targetWeightKg,
+      'fitnessLevel': fitnessLevel,
+      'goalType': goalType,
+      'goalText': goalText,
+      'trainingLocation': trainingLocation,
+      'daysPerWeek': days.length,
+      'availableDays': days,
+      'sessionMinutes': sessionMinutes,
+      'equipmentCodes': equipmentCodes,
+      if (healthNotes != null && healthNotes!.isNotEmpty) 'healthNotes': healthNotes,
+      'allowHighImpact': allowHighImpact,
+      'allowFloorExercises': allowFloorExercises,
+      'allowKneelingExercises': allowKneelingExercises,
+      'allowHangingExercises': allowHangingExercises,
+      'allowOverheadExercises': allowOverheadExercises,
+    };
+  }
+
+  static String _date(DateTime d) =>
+      '${d.year.toString().padLeft(4, '0')}-${d.month.toString().padLeft(2, '0')}-${d.day.toString().padLeft(2, '0')}';
+}
+
+/// `GET /catalog/equipment-types`.
+class EquipmentType {
+  final int id;
+  final String code;
+  final String nameEs;
+  final bool requiresGym;
+  final int displayOrder;
+
+  const EquipmentType({
+    required this.id,
+    required this.code,
+    required this.nameEs,
+    required this.requiresGym,
+    required this.displayOrder,
+  });
+
+  factory EquipmentType.fromJson(Map<String, dynamic> json) {
+    return EquipmentType(
+      id: (json['id'] as num).toInt(),
+      code: json['code'] as String,
+      nameEs: (json['nameEs'] as String?) ?? json['code'] as String,
+      requiresGym: (json['requiresGym'] as bool?) ?? false,
+      displayOrder: (json['displayOrder'] as num?)?.toInt() ?? 0,
+    );
+  }
+}

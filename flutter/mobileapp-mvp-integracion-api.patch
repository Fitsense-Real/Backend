+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:go_router/go_router.dart';
+
+import '../../../../app/router/app_routes.dart';
+import '../../../../core/api/api_exception.dart';
+import '../../../../shared/labels/fitsense_labels.dart';
+import '../../../../shared/widgets/fs_async_view.dart';
+import '../../../../shared/widgets/fs_button.dart';
+import '../../../workout/presentation/providers/workout_provider.dart';
+import '../../../workout/presentation/widgets/skip_workout_sheet.dart';
+import '../../data/models/weekly_plan.dart';
+import '../../domain/services/plan_status.dart';
+import '../providers/plan_provider.dart';
+
+/// Detalle de una sesión del plan: ejercicios, dosis, descanso y acciones.
+class WorkoutDetailPage extends ConsumerWidget {
+  final int plannedWorkoutId;
+
+  const WorkoutDetailPage({super.key, required this.plannedWorkoutId});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final status = ref.watch(planStatusProvider);
+    return FSPageScaffold(
+      title: 'Sesión',
+      body: FSAsyncView<PlanStatus>(
+        value: status,
+        onRetry: () => ref.invalidate(planStatusProvider),
+        builder: (s) {
+          final workout = s.plan?.workoutById(plannedWorkoutId);
+          if (workout == null) return const Text('Esta sesión ya no forma parte de tu plan actual.');
+          return _WorkoutDetail(workout: workout);
+        },
+      ),
+    );
+  }
+}
+
+class _WorkoutDetail extends ConsumerStatefulWidget {
+  final PlannedWorkout workout;
+
+  const _WorkoutDetail({required this.workout});
+
+  @override
+  ConsumerState<_WorkoutDetail> createState() => _WorkoutDetailState();
+}
+
+class _WorkoutDetailState extends ConsumerState<_WorkoutDetail> {
+  bool _starting = false;
+
+  Future<void> _start() async {
+    setState(() => _starting = true);
+    try {
+      final session = await ref.read(workoutRepositoryProvider).start(widget.workout.plannedWorkoutId);
+      ref.invalidate(planStatusProvider);
+      if (!mounted) return;
+      if (!session.countsTowardAdherence) {
+        showFSMessage(context, 'Esta sesión no es de hoy: se registrará, pero no cuenta para tu adherencia.');
+      }
+      context.pushReplacement(AppRoutes.session(session.sessionId));
+    } on ApiException catch (e) {
+      // p. ej., la sesión caducó: el backend decide y la app solo informa.
+      if (mounted) showFSMessage(context, e.fullMessage, error: true);
+    } finally {
+      if (mounted) setState(() => _starting = false);
+    }
+  }
+
+  Future<void> _resumeOrStart() async {
+    final current = await ref.read(workoutRepositoryProvider).current().catchError((_) => null);
+    if (!mounted) return;
+    if (current != null && current.plannedWorkoutId == widget.workout.plannedWorkoutId) {
+      context.pushReplacement(AppRoutes.session(current.sessionId));
+    } else {
+      await _start();
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final w = widget.workout;
+    final theme = Theme.of(context);
+    final expired = w.isExpired(DateTime.now().toUtc());
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Text(w.workoutName, style: theme.textTheme.headlineSmall),
+        Text(
+          '${FitSenseLabels.weekdays[w.scheduledDate.weekday]} ${w.scheduledDate.day}/${w.scheduledDate.month}'
+          '${w.expectedDurationMinutes == null ? '' : ' · ~${w.expectedDurationMinutes} min'}'
+          ' · ${FitSenseLabels.of(FitSenseLabels.workoutStatus, w.status)}',
+        ),
+        if (w.safetyBlocked && w.safetyBlockMessage != null)
+          Card(child: ListTile(leading: const Icon(Icons.block), title: Text(w.safetyBlockMessage!))),
+        const SizedBox(height: 12),
+        ...w.exercises.map((e) => Card(
+              child: ListTile(
+                leading: CircleAvatar(child: Text('${e.exerciseOrder}')),
+                title: Text(e.exerciseName),
+                subtitle: Text([
+                  e.doseText,
+                  if (e.restText != null) e.restText!,
+                  if (e.targetLoadKg != null) '${e.targetLoadKg} kg sugeridos',
+                  if (e.equipment != null) e.equipment!,
+                ].join(' · ')),
+              ),
+            )),
+        const SizedBox(height: 16),
+        if (w.isPending && !expired && !w.safetyBlocked) ...[
+          FSButton(
+            text: w.status == 'IN_PROGRESS' ? 'Continuar entrenamiento' : 'Comenzar entrenamiento',
+            isLoading: _starting,
+            onPressed: _resumeOrStart,
+          ),
+          const SizedBox(height: 8),
+          if (w.status == 'SCHEDULED')
+            OutlinedButton(
+              onPressed: () async {
+                final done = await showSkipWorkoutSheet(context, ref, w.plannedWorkoutId);
+                if (done == true) ref.invalidate(planStatusProvider);
+              },
+              child: const Text('No podré hacerla'),
+            ),
+        ],
+        if (expired && w.isPending)
+          const Text('El plazo para iniciar esta sesión terminó (23:59 del día programado).'),
+      ],
+    );
+  }
+}

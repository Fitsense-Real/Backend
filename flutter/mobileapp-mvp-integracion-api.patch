diff --git a/lib/features/profile/presentation/pages/profile_page.dart b/lib/features/profile/presentation/pages/profile_page.dart
new file mode 100644
index 0000000..a510b9b
--- /dev/null
+++ b/lib/features/profile/presentation/pages/profile_page.dart
@@ -0,0 +1,352 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:go_router/go_router.dart';
+
+import '../../../../app/router/app_routes.dart';
+import '../../../../core/api/api_exception.dart';
+import '../../../../shared/labels/fitsense_labels.dart';
+import '../../../../shared/widgets/fs_async_view.dart';
+import '../../../../shared/widgets/fs_button.dart';
+import '../../../../shared/widgets/fs_options.dart';
+import '../../../../shared/widgets/fs_text_field.dart';
+import '../../../authentication/presentation/providers/auth_provider.dart';
+import '../../../plan/domain/services/plan_status.dart';
+import '../../../plan/presentation/providers/plan_provider.dart';
+import '../../data/models/user_profile.dart';
+import '../providers/profile_provider.dart';
+
+/// Perfil y disponibilidad (`GET`/`POST`/`PUT /users/me/profile`).
+///
+/// Se puede editar hasta que se genera el primer plan; después el backend lo
+/// congela durante el estudio y la pantalla solo lo muestra.
+class ProfilePage extends ConsumerWidget {
+  const ProfilePage({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final profile = ref.watch(profileProvider);
+    final planStatus = ref.watch(planStatusProvider);
+    return FSPageScaffold(
+      title: 'Mi perfil',
+      actions: [
+        IconButton(
+          tooltip: 'Cerrar sesión',
+          icon: const Icon(Icons.logout),
+          onPressed: () async {
+            await ref.read(authViewModelProvider.notifier).logout();
+            if (context.mounted) context.go(AppRoutes.login);
+          },
+        ),
+      ],
+      body: FSAsyncView<UserProfile?>(
+        value: profile,
+        onRetry: () => ref.invalidate(profileProvider),
+        builder: (p) {
+          final locked = p != null && (planStatus.value?.situation ?? PlanSituation.noPlanYet) != PlanSituation.noPlanYet;
+          if (locked) return _ProfileSummary(profile: p);
+          return _ProfileForm(existing: p);
+        },
+      ),
+    );
+  }
+}
+
+class _ProfileSummary extends StatelessWidget {
+  final UserProfile profile;
+
+  const _ProfileSummary({required this.profile});
+
+  @override
+  Widget build(BuildContext context) {
+    final days = profile.availableDays.map((d) => FitSenseLabels.weekdays[d] ?? '$d').join(', ');
+    Widget row(String k, String v) => ListTile(dense: true, title: Text(k), subtitle: Text(v));
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Card(
+          child: Padding(
+            padding: const EdgeInsets.all(16),
+            child: Text(
+              'Tu perfil se mantiene durante todo el estudio porque ya tienes un plan de entrenamiento.',
+              style: Theme.of(context).textTheme.bodyMedium,
+            ),
+          ),
+        ),
+        row('Objetivo', FitSenseLabels.of(FitSenseLabels.goalTypes, profile.goalType)),
+        row('Nivel', FitSenseLabels.of(FitSenseLabels.fitnessLevels, profile.fitnessLevel)),
+        row('Lugar', FitSenseLabels.of(FitSenseLabels.trainingLocations, profile.trainingLocation)),
+        row('Días disponibles', days),
+        row('Minutos por sesión', '${profile.sessionMinutes}'),
+        row('Altura y peso', '${profile.heightCm} cm · ${profile.currentWeightKg} kg'),
+        row('Equipamiento', profile.equipmentCodes.isEmpty ? '—' : profile.equipmentCodes.join(', ')),
+      ],
+    );
+  }
+}
+
+class _ProfileForm extends ConsumerStatefulWidget {
+  final UserProfile? existing;
+
+  const _ProfileForm({this.existing});
+
+  @override
+  ConsumerState<_ProfileForm> createState() => _ProfileFormState();
+}
+
+class _ProfileFormState extends ConsumerState<_ProfileForm> {
+  final _formKey = GlobalKey<FormState>();
+  final _height = TextEditingController();
+  final _weight = TextEditingController();
+  final _targetWeight = TextEditingController();
+  final _goalText = TextEditingController();
+  final _minutes = TextEditingController();
+  final _healthNotes = TextEditingController();
+
+  DateTime? _birthDate;
+  String? _sex;
+  String _level = 'BEGINNER';
+  String _goal = 'GENERAL_FITNESS';
+  String _location = 'HOME';
+  final Set<int> _days = {};
+  final Set<String> _equipment = {'body weight'};
+  bool _highImpact = true, _floor = true, _kneeling = true, _hanging = true, _overhead = true;
+  bool _saving = false;
+
+  bool get _isNew => widget.existing == null;
+
+  @override
+  void initState() {
+    super.initState();
+    final p = widget.existing;
+    if (p != null) {
+      _birthDate = p.birthDate;
+      _sex = p.biologicalSex;
+      _level = p.fitnessLevel;
+      _goal = p.goalType;
+      _location = p.trainingLocation;
+      _days.addAll(p.availableDays);
+      _equipment
+        ..clear()
+        ..addAll(p.equipmentCodes);
+      _height.text = _num(p.heightCm);
+      _weight.text = _num(p.currentWeightKg);
+      _targetWeight.text = p.targetWeightKg == null ? '' : _num(p.targetWeightKg!);
+      _goalText.text = p.goalText;
+      _minutes.text = '${p.sessionMinutes}';
+      _healthNotes.text = p.healthNotes ?? '';
+      _highImpact = p.allowHighImpact;
+      _floor = p.allowFloorExercises;
+      _kneeling = p.allowKneelingExercises;
+      _hanging = p.allowHangingExercises;
+      _overhead = p.allowOverheadExercises;
+    }
+  }
+
+  static String _num(double v) => v == v.roundToDouble() ? v.toInt().toString() : v.toString();
+
+  @override
+  void dispose() {
+    for (final c in [_height, _weight, _targetWeight, _goalText, _minutes, _healthNotes]) {
+      c.dispose();
+    }
+    super.dispose();
+  }
+
+  String? _range(String? v, double min, double max, {bool required = true}) {
+    if (v == null || v.trim().isEmpty) return required ? 'Campo obligatorio' : null;
+    final n = double.tryParse(v.replaceAll(',', '.'));
+    if (n == null) return 'Introduce un número';
+    if (n < min || n > max) return 'Debe estar entre ${_num(min)} y ${_num(max)}';
+    return null;
+  }
+
+  double? _parse(String v) => v.trim().isEmpty ? null : double.tryParse(v.replaceAll(',', '.'));
+
+  Future<void> _pickBirthDate() async {
+    final now = DateTime.now();
+    final picked = await showDatePicker(
+      context: context,
+      initialDate: _birthDate ?? DateTime(now.year - 30),
+      firstDate: DateTime(now.year - 100),
+      lastDate: DateTime(now.year - 14, now.month, now.day),
+      helpText: 'Fecha de nacimiento',
+    );
+    if (picked != null) setState(() => _birthDate = picked);
+  }
+
+  Future<void> _save() async {
+    FocusScope.of(context).unfocus();
+    if (!_formKey.currentState!.validate()) return;
+    if (_isNew && _birthDate == null) {
+      showFSMessage(context, 'Indica tu fecha de nacimiento.', error: true);
+      return;
+    }
+    if (_days.isEmpty) {
+      showFSMessage(context, 'Elige al menos un día disponible.', error: true);
+      return;
+    }
+    setState(() => _saving = true);
+    final request = ProfileRequest(
+      birthDate: _birthDate,
+      biologicalSex: _sex,
+      heightCm: _parse(_height.text)!,
+      currentWeightKg: _parse(_weight.text)!,
+      targetWeightKg: _parse(_targetWeight.text),
+      fitnessLevel: _level,
+      goalType: _goal,
+      goalText: _goalText.text.trim(),
+      trainingLocation: _location,
+      availableDays: _days.toList(),
+      sessionMinutes: int.parse(_minutes.text.trim()),
+      equipmentCodes: _equipment.toList(),
+      healthNotes: _healthNotes.text.trim(),
+      allowHighImpact: _highImpact,
+      allowFloorExercises: _floor,
+      allowKneelingExercises: _kneeling,
+      allowHangingExercises: _hanging,
+      allowOverheadExercises: _overhead,
+    );
+    try {
+      await ref.read(profileRepositoryProvider).saveProfile(request, exists: !_isNew);
+      ref.invalidate(profileProvider);
+      if (!mounted) return;
+      showFSMessage(context, 'Perfil guardado.');
+      context.go(AppRoutes.plan);
+    } on ApiException catch (e) {
+      // 422: rango de minutos del objetivo (P-01) o perfil congelado; se muestra el texto del backend.
+      if (mounted) showFSMessage(context, e.fullMessage, error: true);
+    } finally {
+      if (mounted) setState(() => _saving = false);
+    }
+  }
+
+  Widget _dropdown(String label, String? value, Map<String, String> options, ValueChanged<String?> onChanged,
+      {bool optional = false}) {
+    return FSChoiceChips<String>(
+      label: label,
+      options: options,
+      selected: value,
+      onChanged: onChanged,
+      allowNone: optional,
+    );
+  }
+
+  Widget _field(TextEditingController c, String label, IconData icon, String? Function(String?) validator,
+      {TextInputType type = const TextInputType.numberWithOptions(decimal: true), String? hint}) {
+    return Padding(
+      padding: const EdgeInsets.only(bottom: 16),
+      child: FSTextField(controller: c, label: label, hint: hint, prefixIcon: icon, keyboardType: type, validator: validator),
+    );
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final equipment = ref.watch(equipmentTypesProvider);
+    final theme = Theme.of(context);
+    return Form(
+      key: _formKey,
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Text(_isNew ? 'Completa tu perfil' : 'Revisa tu perfil', style: theme.textTheme.headlineSmall),
+          const SizedBox(height: 8),
+          Text(
+            'Con estos datos se prepara tu plan semanal. Después de generar el primer plan, el perfil '
+            'se mantiene durante todo el estudio.',
+            style: theme.textTheme.bodySmall,
+          ),
+          const SizedBox(height: 20),
+          if (_isNew)
+            Padding(
+              padding: const EdgeInsets.only(bottom: 16),
+              child: OutlinedButton.icon(
+                onPressed: _pickBirthDate,
+                icon: const Icon(Icons.cake_outlined),
+                label: Text(_birthDate == null
+                    ? 'Fecha de nacimiento'
+                    : 'Nacimiento: ${_birthDate!.day}/${_birthDate!.month}/${_birthDate!.year}'),
+              ),
+            ),
+          _dropdown('Sexo biológico (opcional)', _sex, FitSenseLabels.biologicalSex, (v) => setState(() => _sex = v),
+              optional: true),
+          _field(_height, 'Altura (cm)', Icons.height, (v) => _range(v, 120, 250)),
+          _field(_weight, 'Peso actual (kg)', Icons.monitor_weight_outlined, (v) => _range(v, 30, 300)),
+          _field(_targetWeight, 'Peso objetivo (kg, opcional)', Icons.flag_outlined,
+              (v) => _range(v, 30, 300, required: false)),
+          _dropdown('Objetivo', _goal, FitSenseLabels.goalTypes, (v) => setState(() => _goal = v ?? _goal)),
+          _field(_goalText, '¿Qué quieres conseguir?', Icons.edit_note, (v) {
+            if (v == null || v.trim().isEmpty) return 'Cuéntanos tu objetivo en pocas palabras';
+            if (v.length > 500) return 'Máximo 500 caracteres';
+            return null;
+          }, type: TextInputType.text),
+          _dropdown('Nivel', _level, FitSenseLabels.fitnessLevels, (v) => setState(() => _level = v ?? _level)),
+          _dropdown('Dónde entrenas', _location, FitSenseLabels.trainingLocations,
+              (v) => setState(() => _location = v ?? _location)),
+          Text('Días disponibles', style: theme.textTheme.titleSmall),
+          const SizedBox(height: 8),
+          Wrap(
+            spacing: 8,
+            runSpacing: 8,
+            children: FitSenseLabels.weekdays.entries
+                .map((d) => FilterChip(
+                      label: Text(d.value),
+                      selected: _days.contains(d.key),
+                      onSelected: (s) => setState(() => s ? _days.add(d.key) : _days.remove(d.key)),
+                    ))
+                .toList(),
+          ),
+          const SizedBox(height: 16),
+          _field(_minutes, 'Minutos por sesión', Icons.timer_outlined, (v) {
+            final n = int.tryParse(v?.trim() ?? '');
+            if (n == null) return 'Introduce un número entero';
+            if (n < 15 || n > 180) return 'Debe estar entre 15 y 180';
+            return null;
+          },
+              type: TextInputType.number,
+              hint: 'El rango válido depende de tu objetivo; si no encaja, te lo indicaremos'),
+          Text('Equipamiento disponible', style: theme.textTheme.titleSmall),
+          const SizedBox(height: 8),
+          FSAsyncView<List<EquipmentType>>(
+            value: equipment,
+            onRetry: () => ref.invalidate(equipmentTypesProvider),
+            builder: (items) => Wrap(
+              spacing: 8,
+              runSpacing: 8,
+              children: items
+                  .map((e) => FilterChip(
+                        label: Text(e.requiresGym ? '${e.nameEs} (gimnasio)' : e.nameEs),
+                        selected: _equipment.contains(e.code),
+                        onSelected: (s) => setState(() => s ? _equipment.add(e.code) : _equipment.remove(e.code)),
+                      ))
+                  .toList(),
+            ),
+          ),
+          const SizedBox(height: 16),
+          Text('Puedo hacer ejercicios…', style: theme.textTheme.titleSmall),
+          SwitchListTile(
+              title: const Text('de alto impacto (saltos)'),
+              value: _highImpact,
+              onChanged: (v) => setState(() => _highImpact = v)),
+          SwitchListTile(
+              title: const Text('en el suelo'), value: _floor, onChanged: (v) => setState(() => _floor = v)),
+          SwitchListTile(
+              title: const Text('de rodillas'), value: _kneeling, onChanged: (v) => setState(() => _kneeling = v)),
+          SwitchListTile(
+              title: const Text('colgado de una barra'),
+              value: _hanging,
+              onChanged: (v) => setState(() => _hanging = v)),
+          SwitchListTile(
+              title: const Text('con los brazos por encima de la cabeza'),
+              value: _overhead,
+              onChanged: (v) => setState(() => _overhead = v)),
+          const SizedBox(height: 8),
+          _field(_healthNotes, 'Notas de salud (opcional)', Icons.health_and_safety_outlined,
+              (v) => (v != null && v.length > 500) ? 'Máximo 500 caracteres' : null,
+              type: TextInputType.text),
+          const SizedBox(height: 8),
+          FSButton(text: _isNew ? 'Guardar perfil' : 'Actualizar perfil', isLoading: _saving, onPressed: _save),
+        ],
+      ),
+    );
+  }
+}

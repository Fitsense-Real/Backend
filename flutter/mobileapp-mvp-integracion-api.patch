diff --git a/lib/features/progress/presentation/pages/progress_page.dart b/lib/features/progress/presentation/pages/progress_page.dart
new file mode 100644
index 0000000..8ba3850
--- /dev/null
+++ b/lib/features/progress/presentation/pages/progress_page.dart
@@ -0,0 +1,210 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../../../core/api/api_exception.dart';
+import '../../../../shared/labels/fitsense_labels.dart';
+import '../../../../shared/widgets/fs_async_view.dart';
+import '../../../plan/data/models/adaptation_outcome.dart';
+import '../../../plan/presentation/providers/plan_provider.dart';
+import '../../../plan/presentation/widgets/adaptation_banner.dart';
+import '../../data/models/progress_models.dart';
+import '../providers/progress_provider.dart';
+
+/// Adherencia semanal, historial de adaptaciones y ejercicios excluidos por dolor.
+class ProgressPage extends ConsumerWidget {
+  const ProgressPage({super.key});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final metrics = ref.watch(weeklyMetricsProvider);
+    final adaptations = ref.watch(adaptationsProvider);
+    final pain = ref.watch(painExclusionsProvider);
+    final theme = Theme.of(context);
+    return FSPageScaffold(
+      title: 'Mi progreso',
+      onRefresh: () async {
+        ref.invalidate(weeklyMetricsProvider);
+        ref.invalidate(adaptationsProvider);
+        ref.invalidate(painExclusionsProvider);
+      },
+      body: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Text('Adherencia semanal', style: theme.textTheme.titleLarge),
+          const SizedBox(height: 8),
+          FSAsyncView<List<WeeklyMetrics>>(
+            value: metrics,
+            onRetry: () => ref.invalidate(weeklyMetricsProvider),
+            builder: (list) {
+              final withPlan = list.where((m) => m.scheduledWorkouts > 0).toList().reversed.toList();
+              if (withPlan.isEmpty) {
+                return const Text('Tus métricas aparecerán cuando cierre tu primera semana '
+                    '(el lunes a las 03:00, hora local).');
+              }
+              return Column(children: withPlan.map((m) => _MetricsCard(metrics: m)).toList());
+            },
+          ),
+          const SizedBox(height: 24),
+          Text('Cambios en tu plan', style: theme.textTheme.titleLarge),
+          const SizedBox(height: 8),
+          FSAsyncView<List<AdaptationOutcome>>(
+            value: adaptations,
+            onRetry: () => ref.invalidate(adaptationsProvider),
+            builder: (list) => list.isEmpty
+                ? const Text('Todavía no se ha cerrado ninguna semana con tu plan.')
+                : Column(
+                    children: list.reversed
+                        .map((a) => Column(
+                              crossAxisAlignment: CrossAxisAlignment.start,
+                              children: [
+                                if (a.weekStartDate != null)
+                                  Text('Semana del ${a.weekStartDate!.day}/${a.weekStartDate!.month}',
+                                      style: theme.textTheme.labelMedium),
+                                AdaptationBanner(outcome: a),
+                              ],
+                            ))
+                        .toList(),
+                  ),
+          ),
+          const SizedBox(height: 24),
+          Text('Ejercicios pausados por dolor', style: theme.textTheme.titleLarge),
+          const SizedBox(height: 8),
+          FSAsyncView<List<PainExclusion>>(
+            value: pain,
+            onRetry: () => ref.invalidate(painExclusionsProvider),
+            builder: (list) {
+              final active = list.where((p) => p.isActive).toList();
+              if (active.isEmpty) return const Text('No tienes ejercicios pausados.');
+              return Column(children: active.map((p) => _PainTile(exclusion: p)).toList());
+            },
+          ),
+        ],
+      ),
+    );
+  }
+}
+
+String _pct(double? v) => v == null ? '—' : '${v.toStringAsFixed(0)} %';
+
+class _MetricsCard extends StatelessWidget {
+  final WeeklyMetrics metrics;
+
+  const _MetricsCard({required this.metrics});
+
+  @override
+  Widget build(BuildContext context) {
+    final m = metrics;
+    return Card(
+      child: ListTile(
+        title: Text('Semana del ${m.weekStartDate.day}/${m.weekStartDate.month}: adherencia ${_pct(m.weightedAdherencePct)}'),
+        subtitle: Text([
+          '${m.completedWorkouts} de ${m.scheduledWorkouts} sesiones completadas',
+          if (m.skippedWorkouts > 0) '${m.skippedWorkouts} omitidas',
+          'Registro ${_pct(m.registrationCoveragePct)}',
+          if (m.dominantSkipReason != null)
+            'Motivo más frecuente: ${FitSenseLabels.of(FitSenseLabels.skipReasons, m.dominantSkipReason)}',
+        ].join(' · ')),
+      ),
+    );
+  }
+}
+
+class _PainTile extends ConsumerWidget {
+  final PainExclusion exclusion;
+
+  const _PainTile({required this.exclusion});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final e = exclusion;
+    return Card(
+      child: ListTile(
+        leading: const Icon(Icons.healing),
+        title: Text(e.exerciseName ?? 'Ejercicio ${e.exerciseId}'),
+        subtitle: Text(e.eventDate == null ? 'Pausado por dolor' : 'Pausado desde el ${e.eventDate!.day}/${e.eventDate!.month}'),
+        trailing: TextButton(
+          child: const Text('Reincorporar'),
+          onPressed: () async {
+            final ok = await showDialog<bool>(context: context, builder: (_) => _ReactivationDialog(exclusion: e));
+            if (ok == true) {
+              ref.invalidate(painExclusionsProvider);
+              if (context.mounted) {
+                showFSMessage(context, 'El ejercicio podrá volver a tu plan a partir de la próxima semana.');
+              }
+            }
+          },
+        ),
+      ),
+    );
+  }
+}
+
+/// La reincorporación exige marcar la confirmación: nunca se hace automáticamente.
+class _ReactivationDialog extends ConsumerStatefulWidget {
+  final PainExclusion exclusion;
+
+  const _ReactivationDialog({required this.exclusion});
+
+  @override
+  ConsumerState<_ReactivationDialog> createState() => _ReactivationDialogState();
+}
+
+class _ReactivationDialogState extends ConsumerState<_ReactivationDialog> {
+  bool _confirm = false;
+  bool _sending = false;
+  final _comment = TextEditingController();
+  String? _error;
+
+  @override
+  void dispose() {
+    _comment.dispose();
+    super.dispose();
+  }
+
+  Future<void> _send() async {
+    setState(() => _sending = true);
+    try {
+      await ref.read(progressRepositoryProvider).reactivate(
+            widget.exclusion.exerciseId,
+            confirmNoPain: _confirm,
+            comment: _comment.text,
+          );
+      if (mounted) Navigator.pop(context, true);
+    } on ApiException catch (e) {
+      setState(() => _error = e.fullMessage);
+    } finally {
+      if (mounted) setState(() => _sending = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return AlertDialog(
+      title: const Text('Reincorporar ejercicio'),
+      content: SingleChildScrollView(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            Text(widget.exclusion.exerciseName ?? 'Ejercicio ${widget.exclusion.exerciseId}'),
+            CheckboxListTile(
+              contentPadding: EdgeInsets.zero,
+              value: _confirm,
+              onChanged: (v) => setState(() => _confirm = v ?? false),
+              title: const Text('Confirmo que ya no siento dolor ni molestias con este ejercicio.'),
+            ),
+            TextField(
+              controller: _comment,
+              maxLength: 300,
+              decoration: const InputDecoration(labelText: 'Comentario (opcional)'),
+            ),
+            if (_error != null) Text(_error!, style: TextStyle(color: Theme.of(context).colorScheme.error)),
+          ],
+        ),
+      ),
+      actions: [
+        TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('Cancelar')),
+        FilledButton(onPressed: !_confirm || _sending ? null : _send, child: const Text('Reincorporar')),
+      ],
+    );
+  }
+}

+++ b/lib/features/workout/data/datasource/workout_remote_datasource.dart
@@ -0,0 +1,50 @@
+import 'package:dio/dio.dart';
+
+import '../../../../core/api/api_constants.dart';
+import '../../../../core/api/api_exception.dart';
+import '../models/workout_session.dart';
+
+class WorkoutRemoteDataSource {
+  final Dio _dio;
+
+  const WorkoutRemoteDataSource(this._dio);
+
+  /// 201. 422 si la sesión caducó (`expiresAt`) o ya está terminada.
+  Future<WorkoutSession> start(int plannedWorkoutId) => guardApi(() async {
+        final r = await _dio.post(ApiConstants.workoutStart(plannedWorkoutId));
+        return WorkoutSession.fromJson(r.data as Map<String, dynamic>);
+      });
+
+  /// `null` si no hay sesión en curso (204).
+  Future<WorkoutSession?> current() => guardApi(() async {
+        final r = await _dio.get(ApiConstants.sessionCurrent);
+        if (r.statusCode == 204 || r.data == null || r.data is! Map) return null;
+        return WorkoutSession.fromJson(r.data as Map<String, dynamic>);
+      });
+
+  Future<WorkoutSession> byId(int sessionId) => guardApi(() async {
+        final r = await _dio.get(ApiConstants.session(sessionId));
+        return WorkoutSession.fromJson(r.data as Map<String, dynamic>);
+      });
+
+  Future<WorkoutSession> record(int sessionId, int plannedExerciseId, RecordExerciseRequest request) =>
+      guardApi(() async {
+        final r = await _dio.put(ApiConstants.sessionExercise(sessionId, plannedExerciseId), data: request.toJson());
+        return WorkoutSession.fromJson(r.data as Map<String, dynamic>);
+      });
+
+  Future<WorkoutSession> finish(int sessionId, FinishSessionRequest request) => guardApi(() async {
+        final r = await _dio.post(ApiConstants.sessionFinish(sessionId), data: request.toJson());
+        return WorkoutSession.fromJson(r.data as Map<String, dynamic>);
+      });
+
+  Future<WorkoutSession> abandon(int sessionId) => guardApi(() async {
+        final r = await _dio.post(ApiConstants.sessionAbandon(sessionId));
+        return WorkoutSession.fromJson(r.data as Map<String, dynamic>);
+      });
+
+  /// 204.
+  Future<void> skip(int plannedWorkoutId, SkipWorkoutRequest request) => guardApi(() async {
+        await _dio.post(ApiConstants.workoutSkip(plannedWorkoutId), data: request.toJson());
+      });
+}
diff --git a/lib/features/workout/data/models/workout_session.dart b/lib/features/workout/data/models/workout_session.dart
new file mode 100644
index 0000000..2345254
--- /dev/null
+++ b/lib/features/workout/data/models/workout_session.dart
@@ -0,0 +1,168 @@
+/// Modelos de ejecución (`/workouts/*` y `/sessions/*`).
+library;
+
+class WorkoutSession {
+  final int sessionId;
+  final int plannedWorkoutId;
+  final int planId;
+  final int attemptNumber;
+
+  /// `false` si se inició antes del día programado: se registra, pero no cuenta para la adherencia.
+  final bool countsTowardAdherence;
+  final DateTime startedAt;
+  final DateTime? endedAt;
+  final int? activeMinutes;
+  final double completionPercentage;
+  final int? sessionRpe;
+  final int? satisfaction;
+  final String? source;
+  final String status;
+  final List<SessionExercise> exercises;
+
+  const WorkoutSession({
+    required this.sessionId,
+    required this.plannedWorkoutId,
+    required this.planId,
+    required this.attemptNumber,
+    required this.countsTowardAdherence,
+    required this.startedAt,
+    this.endedAt,
+    this.activeMinutes,
+    required this.completionPercentage,
+    this.sessionRpe,
+    this.satisfaction,
+    this.source,
+    required this.status,
+    required this.exercises,
+  });
+
+  factory WorkoutSession.fromJson(Map<String, dynamic> json) {
+    return WorkoutSession(
+      sessionId: (json['sessionId'] as num).toInt(),
+      plannedWorkoutId: (json['plannedWorkoutId'] as num).toInt(),
+      planId: (json['planId'] as num).toInt(),
+      attemptNumber: (json['attemptNumber'] as num?)?.toInt() ?? 1,
+      countsTowardAdherence: (json['countsTowardAdherence'] as bool?) ?? true,
+      startedAt: DateTime.parse(json['startedAt'] as String),
+      endedAt: json['endedAt'] == null ? null : DateTime.parse(json['endedAt'] as String),
+      activeMinutes: (json['activeMinutes'] as num?)?.toInt(),
+      completionPercentage: (json['completionPercentage'] as num?)?.toDouble() ?? 0,
+      sessionRpe: (json['sessionRpe'] as num?)?.toInt(),
+      satisfaction: (json['satisfaction'] as num?)?.toInt(),
+      source: json['source'] as String?,
+      status: json['status'] as String,
+      exercises: ((json['exercises'] as List?) ?? const [])
+          .map((e) => SessionExercise.fromJson(e as Map<String, dynamic>))
+          .toList(),
+    );
+  }
+
+  bool get isInProgress => status == 'IN_PROGRESS';
+
+  SessionExercise? recordFor(int plannedExerciseId) {
+    for (final e in exercises) {
+      if (e.plannedExerciseId == plannedExerciseId) return e;
+    }
+    return null;
+  }
+}
+
+class SessionExercise {
+  final int sessionExerciseId;
+  final int plannedExerciseId;
+  final int? actualSets;
+  final int? actualRepsTotal;
+  final int? actualDurationSeconds;
+  final double? actualLoadKg;
+  final double? completionPercentage;
+  final String? status;
+  final String? skipReason;
+
+  const SessionExercise({
+    required this.sessionExerciseId,
+    required this.plannedExerciseId,
+    this.actualSets,
+    this.actualRepsTotal,
+    this.actualDurationSeconds,
+    this.actualLoadKg,
+    this.completionPercentage,
+    this.status,
+    this.skipReason,
+  });
+
+  factory SessionExercise.fromJson(Map<String, dynamic> json) {
+    return SessionExercise(
+      sessionExerciseId: (json['sessionExerciseId'] as num).toInt(),
+      plannedExerciseId: (json['plannedExerciseId'] as num).toInt(),
+      actualSets: (json['actualSets'] as num?)?.toInt(),
+      actualRepsTotal: (json['actualRepsTotal'] as num?)?.toInt(),
+      actualDurationSeconds: (json['actualDurationSeconds'] as num?)?.toInt(),
+      actualLoadKg: (json['actualLoadKg'] as num?)?.toDouble(),
+      completionPercentage: (json['completionPercentage'] as num?)?.toDouble(),
+      status: json['status'] as String?,
+      skipReason: json['skipReason'] as String?,
+    );
+  }
+
+  bool get hadPain => skipReason == 'PAIN_OR_DISCOMFORT';
+}
+
+/// `RecordExerciseResource`: total de repeticiones (no serie por serie).
+class RecordExerciseRequest {
+  final int? actualSets;
+  final int? actualRepsTotal;
+  final int? actualDurationSeconds;
+  final double? actualLoadKg;
+
+  /// Solo si no se hizo o se dejó a medias. `PAIN_OR_DISCOMFORT` registra dolor
+  /// en ese ejercicio: al cerrar la semana el backend lo excluye (P-02).
+  final String? skipReason;
+
+  const RecordExerciseRequest({
+    this.actualSets,
+    this.actualRepsTotal,
+    this.actualDurationSeconds,
+    this.actualLoadKg,
+    this.skipReason,
+  });
+
+  Map<String, dynamic> toJson() => {
+        'actualSets': actualSets,
+        'actualRepsTotal': actualRepsTotal,
+        'actualDurationSeconds': actualDurationSeconds,
+        'actualLoadKg': actualLoadKg,
+        'skipReason': skipReason,
+      };
+}
+
+/// `FinishSessionResource`: `sessionRpe` (1–10) es obligatorio.
+class FinishSessionRequest {
+  final int sessionRpe;
+  final int? satisfaction;
+  final int? activeMinutes;
+
+  const FinishSessionRequest({required this.sessionRpe, this.satisfaction, this.activeMinutes});
+
+  Map<String, dynamic> toJson() => {
+        'sessionRpe': sessionRpe,
+        if (satisfaction != null) 'satisfaction': satisfaction,
+        if (activeMinutes != null) 'activeMinutes': activeMinutes,
+      };
+}
+
+/// `SkipWorkoutResource`. El contexto y los minutos solo aplican a `LACK_OF_TIME`;
+/// los minutos (15–180) son obligatorios con `MENOS_TIEMPO_HABITUAL`.
+class SkipWorkoutRequest {
+  final String reason;
+  final String? lackOfTimeContext;
+  final int? availableMinutes;
+
+  const SkipWorkoutRequest({required this.reason, this.lackOfTimeContext, this.availableMinutes});
+
+  Map<String, dynamic> toJson() => {
+        'reason': reason,
+        if (reason == 'LACK_OF_TIME' && lackOfTimeContext != null) 'lackOfTimeContext': lackOfTimeContext,
+        if (reason == 'LACK_OF_TIME' && lackOfTimeContext == 'MENOS_TIEMPO_HABITUAL' && availableMinutes != null)
+          'availableMinutes': availableMinutes,
+      };
+}

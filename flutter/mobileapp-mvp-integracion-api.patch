+
+  static String _num(double v) => v == v.roundToDouble() ? v.toInt().toString() : v.toStringAsFixed(1);
+
+  static Widget _nextStep(BuildContext context, PlanStatus s) {
+    switch (s.situation) {
+      case PlanSituation.noPlanYet:
+        return TodayWorkoutCard(
+          title: 'Tu plan',
+          subtitle: 'Todavía no tienes un plan',
+          buttonText: 'Generar mi plan',
+          onPressed: () => context.push(AppRoutes.plan),
+        );
+      case PlanSituation.notFeasible:
+        return TodayWorkoutCard(
+          title: 'Tu plan',
+          subtitle: AdaptationMessages.notFeasible,
+          detail: AdaptationMessages.notFeasibleHelp,
+          buttonText: 'Ver detalle',
+          onPressed: () => context.push(AppRoutes.plan),
+        );
+      case PlanSituation.waitingCycle:
+        return TodayWorkoutCard(
+          title: 'Tu plan',
+          subtitle: 'Tu nueva semana se está preparando',
+          buttonText: 'Ver mi plan',
+          onPressed: () => context.push(AppRoutes.plan),
+        );
+      case PlanSituation.active:
+        final today = DateTime.now();
+        final pending = s.plan!.workouts.where((w) => w.isPending && !w.isExpired(today.toUtc())).toList();
+        if (pending.isEmpty) {
+          return TodayWorkoutCard(
+            title: 'Rutina de la semana',
+            subtitle: 'No te quedan sesiones pendientes',
+            buttonText: 'Ver mi plan',
+            onPressed: () => context.push(AppRoutes.plan),
+          );
+        }
+        final next = pending.first;
+        final isToday = next.scheduledDate.year == today.year &&
+            next.scheduledDate.month == today.month &&
+            next.scheduledDate.day == today.day;
+        return TodayWorkoutCard(
+          title: isToday ? 'Rutina de hoy' : 'Próxima rutina',
+          subtitle: next.workoutName,
+          detail: [
+            '${next.exercises.length} ejercicios',
+            if (next.expectedDurationMinutes != null) '~${next.expectedDurationMinutes} minutos',
+            if (!isToday) '${next.scheduledDate.day}/${next.scheduledDate.month}',
+          ].join(' · '),
+          buttonText: isToday ? 'Comenzar entrenamiento' : 'Ver sesión',
+          onPressed: () => context.push(AppRoutes.workoutDetail(next.plannedWorkoutId)),
+        );
+    }
+  }
+
+  static String _lastAdherence(List<WeeklyMetrics>? list) {
+    final closed = (list ?? const <WeeklyMetrics>[]).where((m) => m.weightedAdherencePct != null).toList();
+    if (closed.isEmpty) return '—';
+    return '${closed.last.weightedAdherencePct!.toStringAsFixed(0)} %';
+  }
+
+  static String _sessions(PlanStatus? s) {
+    final plan = s?.plan;
+    if (plan == null) return '—';
+    final done = plan.workouts.where((w) => w.status == 'COMPLETED' || w.status == 'PARTIAL').length;
+    return '$done/${plan.workouts.length}';
+  }
+
+  static String _planMessage(PlanStatus? s) {
+    if (s == null) return 'Cargando…';
+    final outcome = s.lastAdaptation;
+    if (outcome != null) return AdaptationMessages.of(outcome).title;
+    return switch (s.situation) {
+      PlanSituation.active => 'Esta es tu primera semana. Registra cada sesión para que tu plan se ajuste a ti.',
+      PlanSituation.noPlanYet => 'Cuando generes tu plan verás aquí cómo evoluciona cada semana.',
+      _ => 'Tu nueva semana se está preparando.',
+    };
+  }
+}

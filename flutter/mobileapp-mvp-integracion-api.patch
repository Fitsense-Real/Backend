+/// `WeeklyMetricsResource` (`/users/me/metrics/weekly`). Las métricas de una
+/// semana solo existen cuando la semana cierra (lunes 03:00, hora local).
+class WeeklyMetrics {
+  final int weeklyMetricId;
+  final int? planId;
+  final int weekNumber;
+  final DateTime weekStartDate;
+  final DateTime weekEndDate;
+  final bool hasActivePlan;
+  final int scheduledWorkouts;
+  final int completedWorkouts;
+  final int skippedWorkouts;
+  final double? weightedAdherencePct;
+  final double? observedAdherencePct;
+  final double? registrationCoveragePct;
+  final int totalTrainingMinutes;
+  final double? averageSessionRpe;
+  final String? dominantSkipReason;
+
+  const WeeklyMetrics({
+    required this.weeklyMetricId,
+    this.planId,
+    required this.weekNumber,
+    required this.weekStartDate,
+    required this.weekEndDate,
+    required this.hasActivePlan,
+    required this.scheduledWorkouts,
+    required this.completedWorkouts,
+    required this.skippedWorkouts,
+    this.weightedAdherencePct,
+    this.observedAdherencePct,
+    this.registrationCoveragePct,
+    required this.totalTrainingMinutes,
+    this.averageSessionRpe,
+    this.dominantSkipReason,
+  });
+
+  factory WeeklyMetrics.fromJson(Map<String, dynamic> json) {
+    double? d(String k) => (json[k] as num?)?.toDouble();
+    int i(String k) => (json[k] as num?)?.toInt() ?? 0;
+    return WeeklyMetrics(
+      weeklyMetricId: (json['weeklyMetricId'] as num).toInt(),
+      planId: (json['planId'] as num?)?.toInt(),
+      weekNumber: i('weekNumber'),
+      weekStartDate: DateTime.parse(json['weekStartDate'] as String),
+      weekEndDate: DateTime.parse(json['weekEndDate'] as String),
+      hasActivePlan: (json['hasActivePlan'] as bool?) ?? false,
+      scheduledWorkouts: i('scheduledWorkouts'),
+      completedWorkouts: i('completedWorkouts'),
+      skippedWorkouts: i('skippedWorkouts'),
+      weightedAdherencePct: d('weightedAdherencePct'),
+      observedAdherencePct: d('observedAdherencePct'),
+      registrationCoveragePct: d('registrationCoveragePct'),
+      totalTrainingMinutes: i('totalTrainingMinutes'),
+      averageSessionRpe: d('averageSessionRpe'),
+      dominantSkipReason: json['dominantSkipReason'] as String?,
+    );
+  }
+}
+
+/// `PainExclusionResource` (P-02). La reincorporación solo ocurre con la
+/// confirmación explícita del usuario; la app nunca la hace por su cuenta.
+class PainExclusion {
+  final int exclusionId;
+  final int exerciseId;
+  final String? exerciseName;
+  final String? reason;
+  final DateTime? eventDate;
+  final String status;
+  final DateTime? reactivatedAt;
+
+  const PainExclusion({
+    required this.exclusionId,
+    required this.exerciseId,
+    this.exerciseName,
+    this.reason,
+    this.eventDate,
+    required this.status,
+    this.reactivatedAt,
+  });
+
+  factory PainExclusion.fromJson(Map<String, dynamic> json) {
+    return PainExclusion(
+      exclusionId: (json['exclusionId'] as num).toInt(),
+      exerciseId: (json['exerciseId'] as num).toInt(),
+      exerciseName: json['exerciseName'] as String?,
+      reason: json['reason'] as String?,
+      eventDate: json['eventDate'] == null ? null : DateTime.parse(json['eventDate'] as String),
+      status: (json['status'] as String?) ?? '',
+      reactivatedAt: json['reactivatedAt'] == null ? null : DateTime.parse(json['reactivatedAt'] as String),
+    );
+  }
+
+  bool get isActive => status == 'ACTIVA';
+}

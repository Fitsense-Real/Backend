+import '../../domain/repositories/progress_repository.dart';
+import '../datasource/progress_remote_datasource.dart';
+import '../models/progress_models.dart';
+
+class ProgressRepositoryImpl implements ProgressRepository {
+  final ProgressRemoteDataSource remote;
+
+  ProgressRepositoryImpl(this.remote);
+
+  @override
+  Future<List<WeeklyMetrics>> weeklyMetrics() => remote.weeklyMetrics();
+
+  @override
+  Future<List<PainExclusion>> painExclusions() => remote.painExclusions();
+
+  @override
+  Future<void> reactivate(int exerciseId, {required bool confirmNoPain, String? comment}) {
+    // Defensa en profundidad: sin confirmación explícita no se llama al backend.
+    if (!confirmNoPain) {
+      throw ArgumentError('La reincorporación requiere la confirmación explícita del usuario.');
+    }
+    return remote.reactivate(exerciseId, confirmNoPain: true, comment: comment);
+  }
+}

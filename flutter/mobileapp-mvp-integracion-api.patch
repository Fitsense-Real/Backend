+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../../../core/api/api_exception.dart';
+import '../../../../shared/labels/fitsense_labels.dart';
+import '../../../../shared/widgets/fs_options.dart';
+import '../../data/models/workout_session.dart';
+import '../providers/workout_provider.dart';
+
+/// `POST /workouts/{id}/skip` con su motivo. Devuelve `true` si se registró.
+Future<bool?> showSkipWorkoutSheet(BuildContext context, WidgetRef ref, int plannedWorkoutId) {
+  return showModalBottomSheet<bool>(
+    context: context,
+    isScrollControlled: true,
+    builder: (_) => _SkipSheet(plannedWorkoutId: plannedWorkoutId, ref: ref),
+  );
+}
+
+class _SkipSheet extends StatefulWidget {
+  final int plannedWorkoutId;
+  final WidgetRef ref;
+
+  const _SkipSheet({required this.plannedWorkoutId, required this.ref});
+
+  @override
+  State<_SkipSheet> createState() => _SkipSheetState();
+}
+
+class _SkipSheetState extends State<_SkipSheet> {
+  String? _reason;
+  String? _context;
+  final _minutes = TextEditingController();
+  bool _sending = false;
+  String? _error;
+
+  @override
+  void dispose() {
+    _minutes.dispose();
+    super.dispose();
+  }
+
+  Future<void> _send() async {
+    if (_reason == null) return;
+    int? minutes;
+    if (_reason == 'LACK_OF_TIME' && _context == 'MENOS_TIEMPO_HABITUAL') {
+      minutes = int.tryParse(_minutes.text.trim());
+      if (minutes == null || minutes < 15 || minutes > 180) {
+        setState(() => _error = 'Indica los minutos que sueles tener (de 15 a 180).');
+        return;
+      }
+    }
+    setState(() {
+      _sending = true;
+      _error = null;
+    });
+    try {
+      await widget.ref.read(workoutRepositoryProvider).skip(
+            widget.plannedWorkoutId,
+            SkipWorkoutRequest(reason: _reason!, lackOfTimeContext: _context, availableMinutes: minutes),
+          );
+      if (mounted) Navigator.of(context).pop(true);
+    } on ApiException catch (e) {
+      setState(() => _error = e.fullMessage);
+    } finally {
+      if (mounted) setState(() => _sending = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return Padding(
+      padding: EdgeInsets.fromLTRB(20, 20, 20, 20 + MediaQuery.of(context).viewInsets.bottom),
+      child: SingleChildScrollView(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Text('¿Por qué no podrás hacerla?', style: Theme.of(context).textTheme.titleLarge),
+            const SizedBox(height: 4),
+            const Text('El motivo permite ajustar tu semana siguiente.'),
+            FSOptionList<String>(
+              options: FitSenseLabels.skipReasons,
+              selected: _reason,
+              onChanged: (v) => setState(() {
+                _reason = v;
+                _context = null;
+              }),
+            ),
+            if (_reason == 'LACK_OF_TIME') ...[
+              const Divider(),
+              FSOptionList<String>(
+                options: FitSenseLabels.lackOfTimeContexts,
+                selected: _context,
+                onChanged: (v) => setState(() => _context = v),
+              ),
+              if (_context == 'MENOS_TIEMPO_HABITUAL')
+                TextField(
+                  controller: _minutes,
+                  keyboardType: TextInputType.number,
+                  decoration: const InputDecoration(labelText: 'Minutos que sueles tener (15–180)'),
+                ),
+            ],
+            if (_error != null)
+              Padding(
+                padding: const EdgeInsets.only(top: 8),
+                child: Text(_error!, style: TextStyle(color: Theme.of(context).colorScheme.error)),
+              ),
+            const SizedBox(height: 12),
+            FilledButton(
+              onPressed: _reason == null || _sending ? null : _send,
+              child: Text(_sending ? 'Enviando…' : 'Registrar'),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}

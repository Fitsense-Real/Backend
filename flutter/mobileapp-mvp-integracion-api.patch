+import 'package:dio/dio.dart';
+import 'package:fitsense_mobile/features/progress/data/datasource/progress_remote_datasource.dart';
+import 'package:fitsense_mobile/features/progress/data/repositories/progress_repository_impl.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../support/fake_adapter.dart';
+
+void main() {
+  late FakeAdapter adapter;
+  late ProgressRepositoryImpl repo;
+
+  setUp(() {
+    adapter = FakeAdapter({'POST /users/me/pain-exclusions/755/reactivation': (200, null)});
+    repo = ProgressRepositoryImpl(
+        ProgressRemoteDataSource(Dio(BaseOptions(baseUrl: 'http://backend.invalid'))..httpClientAdapter = adapter));
+  });
+
+  test('sin confirmación explícita no se reincorpora (ni se llama al backend)', () {
+    expect(() => repo.reactivate(755, confirmNoPain: false), throwsArgumentError);

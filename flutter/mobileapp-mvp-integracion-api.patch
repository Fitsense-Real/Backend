@@ -0,0 +1,90 @@
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../core/api/api_exception.dart';
+import 'fs_loading.dart';
+
+/// Pinta un `AsyncValue` con carga, error (con reintento) y datos.
+class FSAsyncView<T> extends StatelessWidget {
+  final AsyncValue<T> value;
+  final Widget Function(T data) builder;
+  final VoidCallback? onRetry;
+
+  const FSAsyncView({super.key, required this.value, required this.builder, this.onRetry});
+
+  @override
+  Widget build(BuildContext context) {
+    return value.when(
+      data: builder,
+      loading: () => const Padding(padding: EdgeInsets.all(32), child: FSLoading()),
+      error: (e, _) => FSErrorView(error: e, onRetry: onRetry),
+    );
+  }
+}
+
+class FSErrorView extends StatelessWidget {
+  final Object error;
+  final VoidCallback? onRetry;
+
+  const FSErrorView({super.key, required this.error, this.onRetry});
+
+  @override
+  Widget build(BuildContext context) {
+    final message = error is ApiException ? (error as ApiException).fullMessage : 'Ha ocurrido un error inesperado.';
+    return Padding(
+      padding: const EdgeInsets.all(24),
+      child: Column(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          Icon(Icons.cloud_off_outlined, size: 40, color: Theme.of(context).colorScheme.error),
+          const SizedBox(height: 12),
+          Text(message, textAlign: TextAlign.center),
+          if (onRetry != null) ...[
+            const SizedBox(height: 12),
+            OutlinedButton.icon(onPressed: onRetry, icon: const Icon(Icons.refresh), label: const Text('Reintentar')),
+          ],
+        ],
+      ),
+    );
+  }
+}
+
+/// Estructura común de las pantallas del MVP: barra superior y fondo de la app.
+class FSPageScaffold extends StatelessWidget {
+  final String title;
+  final Widget body;
+  final List<Widget>? actions;
+  final Future<void> Function()? onRefresh;
+
+  const FSPageScaffold({super.key, required this.title, required this.body, this.actions, this.onRefresh});
+
+  @override
+  Widget build(BuildContext context) {
+    final content = SafeArea(
+      top: false,
+      child: SingleChildScrollView(
+        physics: const AlwaysScrollableScrollPhysics(),
+        padding: const EdgeInsets.all(20),
+        child: body,
+      ),
+    );
+    return Scaffold(
+      appBar: AppBar(title: Text(title), actions: actions, backgroundColor: Colors.transparent),
+      extendBodyBehindAppBar: false,
+      body: Container(
+        color: Theme.of(context).scaffoldBackgroundColor,
+        child: onRefresh == null ? content : RefreshIndicator(onRefresh: onRefresh!, child: content),
+      ),
+    );
+  }
+}
+
+void showFSMessage(BuildContext context, String message, {bool error = false}) {
+  ScaffoldMessenger.of(context).showSnackBar(
+    SnackBar(
+      behavior: SnackBarBehavior.floating,
+      backgroundColor: error ? Theme.of(context).colorScheme.error : null,
+      content: Text(message),
+    ),
+  );
+}

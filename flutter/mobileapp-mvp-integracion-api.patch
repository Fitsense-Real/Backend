+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:go_router/go_router.dart';
+
+import '../../../../app/router/app_routes.dart';
+import '../../../../core/api/api_exception.dart';
+import '../../../../shared/labels/fitsense_labels.dart';
+import '../../../../shared/widgets/fs_async_view.dart';
+import '../../../../shared/widgets/fs_button.dart';
+import '../../../../shared/widgets/fs_options.dart';
+import '../../../plan/data/models/weekly_plan.dart';
+import '../../../plan/presentation/providers/plan_provider.dart';
+import '../../data/models/workout_session.dart';
+import '../providers/workout_provider.dart';
+
+/// Entrenamiento en curso: registro por ejercicio, dolor, fin con esfuerzo (RPE) y abandono.
+class SessionPage extends ConsumerWidget {
+  final int sessionId;
+
+  const SessionPage({super.key, required this.sessionId});
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final session = ref.watch(sessionByIdProvider(sessionId));
+    final plan = ref.watch(planStatusProvider);
+    return FSPageScaffold(
+      title: 'Entrenamiento',
+      body: FSAsyncView<WorkoutSession>(
+        value: session,
+        onRetry: () => ref.invalidate(sessionByIdProvider(sessionId)),
+        builder: (s) => FSAsyncView(
+          value: plan,
+          onRetry: () => ref.invalidate(planStatusProvider),
+          builder: (p) {
+            final workout = p.plan?.workoutById(s.plannedWorkoutId);
+            if (workout == null) return const Text('No se encontró la sesión en tu plan actual.');
+            return _SessionBody(session: s, workout: workout);
+          },
+        ),
+      ),
+    );
+  }
+}
+
+class _SessionBody extends ConsumerWidget {
+  final WorkoutSession session;
+  final PlannedWorkout workout;
+
+  const _SessionBody({required this.session, required this.workout});
+
+  void _refresh(WidgetRef ref) => ref.invalidate(sessionByIdProvider(session.sessionId));
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final theme = Theme.of(context);
+    final open = session.isInProgress;
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Text(workout.workoutName, style: theme.textTheme.headlineSmall),
+        Text('${FitSenseLabels.of(FitSenseLabels.sessionStatus, session.status)} · '
+            '${session.completionPercentage.toStringAsFixed(0)} % completado'),
+        if (!session.countsTowardAdherence)
+          const Padding(
+            padding: EdgeInsets.only(top: 6),
+            child: Text('Esta sesión no es la del día: se guarda, pero no cuenta para tu adherencia.'),
+          ),
+        const SizedBox(height: 12),
+        ...workout.exercises.map((e) {
+          final record = session.recordFor(e.plannedExerciseId);
+          return Card(
+            child: ListTile(
+              title: Text(e.exerciseName),
+              subtitle: Text('Plan: ${e.doseText}${e.restText == null ? '' : ' · ${e.restText}'}'
+                  '${record == null ? '' : '\nRegistrado: ${_recordText(e, record)}'}'),
+              isThreeLine: record != null,
+              trailing: record == null
+                  ? const Icon(Icons.radio_button_unchecked)
+                  : Icon(record.hadPain ? Icons.healing : Icons.check_circle,
+                      color: record.hadPain ? theme.colorScheme.error : theme.colorScheme.primary),
+              onTap: open
+                  ? () async {
+                      final saved = await showModalBottomSheet<bool>(
+                        context: context,
+                        isScrollControlled: true,
+                        builder: (_) => _RecordSheet(sessionId: session.sessionId, exercise: e, previous: record),
+                      );
+                      if (saved == true) _refresh(ref);
+                    }
+                  : null,
+            ),
+          );
+        }),
+        const SizedBox(height: 16),
+        if (open) ...[
+          FSButton(
+            text: 'Terminar entrenamiento',
+            onPressed: () async {
+              final done = await showDialog<bool>(
+                context: context,
+                builder: (_) => _FinishDialog(sessionId: session.sessionId),
+              );
+              if (done == true && context.mounted) {
+                ref.invalidate(planStatusProvider);
+                _refresh(ref);
+                showFSMessage(context, 'Entrenamiento guardado.');
+              }
+            },
+          ),
+          const SizedBox(height: 8),
+          OutlinedButton(
+            onPressed: () async {
+              final confirm = await showDialog<bool>(
+                context: context,
+                builder: (c) => AlertDialog(
+                  title: const Text('¿Abandonar el entrenamiento?'),
+                  content: const Text('Lo registrado hasta ahora se conserva.'),
+                  actions: [
+                    TextButton(onPressed: () => Navigator.pop(c, false), child: const Text('Seguir')),
+                    TextButton(onPressed: () => Navigator.pop(c, true), child: const Text('Abandonar')),
+                  ],
+                ),
+              );
+              if (confirm != true) return;
+              try {
+                await ref.read(workoutRepositoryProvider).abandon(session.sessionId);
+                ref.invalidate(planStatusProvider);
+                _refresh(ref);
+              } on ApiException catch (e) {
+                if (context.mounted) showFSMessage(context, e.fullMessage, error: true);
+              }
+            },
+            child: const Text('Abandonar'),
+          ),
+        ] else
+          FSButton(text: 'Volver a mi plan', onPressed: () => context.go(AppRoutes.plan)),
+      ],
+    );
+  }
+
+  static String _recordText(PlannedExercise e, SessionExercise r) {
+    if (r.skipReason != null) return FitSenseLabels.of(FitSenseLabels.skipReasons, r.skipReason);
+    final sets = r.actualSets ?? 0;
+    if (e.isDuration) return '$sets series · ${r.actualDurationSeconds ?? 0} s';
+    return '$sets series · ${r.actualRepsTotal ?? 0} repeticiones';
+  }
+}
+
+class _RecordSheet extends ConsumerStatefulWidget {
+  final int sessionId;
+  final PlannedExercise exercise;
+  final SessionExercise? previous;
+
+  const _RecordSheet({required this.sessionId, required this.exercise, this.previous});
+
+  @override
+  ConsumerState<_RecordSheet> createState() => _RecordSheetState();
+}
+
+class _RecordSheetState extends ConsumerState<_RecordSheet> {
+  late final TextEditingController _sets;
+  late final TextEditingController _amount;
+  late final TextEditingController _load;
+  bool _done = true;
+  String? _notDoneReason;
+  bool _sending = false;
+  String? _error;
+
+  @override
+  void initState() {
+    super.initState();
+    final e = widget.exercise;
+    final p = widget.previous;
+    _done = p?.skipReason == null;
+    _notDoneReason = p?.skipReason;
+    _sets = TextEditingController(text: '${p?.actualSets ?? e.plannedSets ?? 1}');
+    final plannedAmount = e.isDuration
+        ? (e.plannedDurationSeconds ?? 0)
+        : (e.plannedReps ?? 0) * (e.plannedSets ?? 1);
+    _amount = TextEditingController(
+        text: '${(e.isDuration ? p?.actualDurationSeconds : p?.actualRepsTotal) ?? plannedAmount}');
+    _load = TextEditingController(text: p?.actualLoadKg?.toString() ?? '');
+  }
+
+  @override
+  void dispose() {
+    _sets.dispose();
+    _amount.dispose();
+    _load.dispose();
+    super.dispose();
+  }
+
+  Future<void> _save() async {
+    final e = widget.exercise;
+    RecordExerciseRequest request;
+    if (_done) {
+      final sets = int.tryParse(_sets.text.trim());
+      final amount = int.tryParse(_amount.text.trim());
+      if (sets == null || sets < 0 || amount == null || amount < 0) {
+        setState(() => _error = 'Revisa los valores: deben ser números enteros, sin negativos.');
+        return;
+      }
+      request = RecordExerciseRequest(
+        actualSets: sets,
+        actualRepsTotal: e.isDuration ? null : amount,
+        actualDurationSeconds: e.isDuration ? amount : null,
+        actualLoadKg: double.tryParse(_load.text.replaceAll(',', '.')),
+      );
+    } else {
+      if (_notDoneReason == null) {
+        setState(() => _error = 'Indica por qué no lo hiciste.');
+        return;
+      }
+      request = RecordExerciseRequest(actualSets: 0, skipReason: _notDoneReason);
+    }
+    setState(() {
+      _sending = true;
+      _error = null;
+    });
+    try {
+      await ref.read(workoutRepositoryProvider).record(widget.sessionId, e.plannedExerciseId, request);
+      if (mounted) Navigator.pop(context, true);
+    } on ApiException catch (ex) {
+      setState(() => _error = ex.fullMessage);
+    } finally {
+      if (mounted) setState(() => _sending = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final e = widget.exercise;
+    return Padding(
+      padding: EdgeInsets.fromLTRB(20, 20, 20, 20 + MediaQuery.of(context).viewInsets.bottom),
+      child: SingleChildScrollView(
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          crossAxisAlignment: CrossAxisAlignment.stretch,
+          children: [
+            Text(e.exerciseName, style: Theme.of(context).textTheme.titleLarge),
+            Text('Plan: ${e.doseText}'),
+            SwitchListTile(
+              title: const Text('Lo hice'),
+              value: _done,
+              onChanged: (v) => setState(() => _done = v),
+            ),
+            if (_done) ...[
+              TextField(
+                controller: _sets,
+                keyboardType: TextInputType.number,
+                decoration: const InputDecoration(labelText: 'Series hechas'),
+              ),
+              TextField(
+                controller: _amount,
+                keyboardType: TextInputType.number,
+                decoration: InputDecoration(
+                    labelText: e.isDuration ? 'Segundos en total' : 'Repeticiones en total (todas las series)'),
+              ),
+              TextField(
+                controller: _load,
+                keyboardType: const TextInputType.numberWithOptions(decimal: true),
+                decoration: const InputDecoration(labelText: 'Peso usado en kg (opcional)'),
+              ),
+            ] else
+              FSOptionList<String>(
+                options: FitSenseLabels.skipReasons,
+                selected: _notDoneReason,
+                onChanged: (v) => setState(() => _notDoneReason = v),
+                descriptions: const {
+                  'PAIN_OR_DISCOMFORT': 'Este ejercicio no volverá a tu plan hasta que tú lo reincorpores.',
+                },
+              ),
+            if (_error != null)
+              Padding(
+                padding: const EdgeInsets.only(top: 8),
+                child: Text(_error!, style: TextStyle(color: Theme.of(context).colorScheme.error)),
+              ),
+            const SizedBox(height: 12),
+            FilledButton(onPressed: _sending ? null : _save, child: Text(_sending ? 'Guardando…' : 'Guardar')),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+class _FinishDialog extends ConsumerStatefulWidget {
+  final int sessionId;
+
+  const _FinishDialog({required this.sessionId});
+
+  @override
+  ConsumerState<_FinishDialog> createState() => _FinishDialogState();
+}
+
+class _FinishDialogState extends ConsumerState<_FinishDialog> {
+  double _rpe = 6;
+  int? _satisfaction;
+  bool _sending = false;
+  String? _error;
+
+  Future<void> _finish() async {
+    setState(() => _sending = true);
+    try {
+      await ref.read(workoutRepositoryProvider).finish(
+            widget.sessionId,
+            FinishSessionRequest(sessionRpe: _rpe.round(), satisfaction: _satisfaction),
+          );
+      if (mounted) Navigator.pop(context, true);
+    } on ApiException catch (e) {
+      setState(() => _error = e.fullMessage);
+    } finally {
+      if (mounted) setState(() => _sending = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    return AlertDialog(
+      title: const Text('¿Cómo fue el entrenamiento?'),
+      content: Column(
+        mainAxisSize: MainAxisSize.min,
+        crossAxisAlignment: CrossAxisAlignment.start,
+        children: [
+          Text('Esfuerzo percibido: ${_rpe.round()} de 10'),
+          Slider(value: _rpe, min: 1, max: 10, divisions: 9, onChanged: (v) => setState(() => _rpe = v)),
+          const Text('Satisfacción (opcional)'),
+          Wrap(
+            spacing: 4,
+            children: List.generate(5, (i) {
+              final v = i + 1;
+              return ChoiceChip(
+                label: Text('$v'),
+                selected: _satisfaction == v,
+                onSelected: (s) => setState(() => _satisfaction = s ? v : null),
+              );
+            }),
+          ),
+          if (_error != null)
+            Text(_error!, style: TextStyle(color: Theme.of(context).colorScheme.error)),
+        ],
+      ),
+      actions: [
+        TextButton(onPressed: () => Navigator.pop(context, false), child: const Text('Cancelar')),
+        FilledButton(onPressed: _sending ? null : _finish, child: const Text('Guardar')),
+      ],
+    );
+  }
+}

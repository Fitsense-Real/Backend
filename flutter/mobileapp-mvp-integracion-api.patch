+import 'package:flutter/material.dart';
+
+import '../../data/models/adaptation_outcome.dart';
+import '../../domain/services/adaptation_messages.dart';
+
+/// Mensaje del ciclo semanal. El detalle técnico va plegado y se muestra tal cual,
+/// sin interpretarlo como una causa médica.
+class AdaptationBanner extends StatelessWidget {
+  final AdaptationOutcome outcome;
+
+  const AdaptationBanner({super.key, required this.outcome});
+
+  @override
+  Widget build(BuildContext context) {
+    final message = AdaptationMessages.of(outcome);
+    final scheme = Theme.of(context).colorScheme;
+    final icon = switch (message.kind) {
+      AdaptationMessageKind.kept => Icons.event_repeat,
+      AdaptationMessageKind.adjusted => Icons.tune,
+      AdaptationMessageKind.safetySubstitution => Icons.health_and_safety_outlined,
+      AdaptationMessageKind.notFeasible => Icons.info_outline,
+      AdaptationMessageKind.progression => Icons.trending_up,
+      AdaptationMessageKind.unknown => Icons.update,
+    };
+    return Card(
+      child: Theme(
+        data: Theme.of(context).copyWith(dividerColor: Colors.transparent),
+        child: ExpansionTile(
+          leading: Icon(icon, color: scheme.primary),
+          title: Text(message.title),
+          subtitle: message.isNotFeasible ? const Text(AdaptationMessages.notFeasibleHelp) : null,
+          childrenPadding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
+          expandedCrossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            Text('Detalle técnico', style: Theme.of(context).textTheme.labelMedium),
+            const SizedBox(height: 4),
+            ...message.technicalDetail.map((d) => Text(d, style: Theme.of(context).textTheme.bodySmall)),
+          ],
+        ),
+      ),
+    );
+  }
+}

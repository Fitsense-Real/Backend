@@ -0,0 +1,70 @@
+import 'package:dio/dio.dart';
+import 'package:fitsense_mobile/core/api/api_exception.dart';
+import 'package:fitsense_mobile/core/network/auth_interceptor.dart';
+import 'package:fitsense_mobile/core/storage/token_storage.dart';
+import 'package:fitsense_mobile/features/authentication/data/datasource/auth_remote_datasource.dart';
+import 'package:fitsense_mobile/features/authentication/data/repositories/auth_repository_impl.dart';
+import 'package:flutter_secure_storage/flutter_secure_storage.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../support/fake_adapter.dart';
+import '../support/fixtures.dart';
+
+/// Flujo de autenticación con respuestas SIMULADAS (cuerpos reales capturados).
+/// No sustituye la prueba contra el backend (`test/integration`).
+void main() {
+  late FakeAdapter adapter;
+  late AuthRepositoryImpl repo;
+
+  setUp(() {
+    FlutterSecureStorage.setMockInitialValues({});
+    adapter = FakeAdapter({
+      'POST /auth/register': (201, fixtureMap('register')),
+      'POST /auth/login': (200, fixtureMap('login')),
+      'GET /users/me': (200, fixtureMap('me')),
+    });
+    final dio = Dio(BaseOptions(baseUrl: 'http://backend.invalid/api/v1'))
+      ..httpClientAdapter = adapter
+      ..interceptors.add(AuthInterceptor());
+    repo = AuthRepositoryImpl(AuthRemoteDataSource(dio));
+  });
+
+  test('registro → login (el registro no da token) → users/me con Bearer', () async {
+    final user = await repo.register(
+      firstName: 'Ana',
+      lastName: 'Prueba',
+      email: 'mvp1@pruebas.invalid',
+      password: 'ClaveSegura123',
+      acceptsStudyParticipation: true,
+    );
+    expect(user.id, 1);
+    expect(user.fullName, 'Ana Prueba');
+    expect(adapter.requests.map((r) => '${r.method} ${r.path}'),
+        ['POST /auth/register', 'POST /auth/login', 'GET /users/me']);
+    expect(adapter.requests[0].headers.containsKey('Authorization'), isFalse);
+    expect(adapter.requests[1].headers.containsKey('Authorization'), isFalse);
+    expect(adapter.requests[2].headers['Authorization'], 'Bearer token-de-prueba-no-valido');
+    expect(await TokenStorage.getToken(), 'token-de-prueba-no-valido');
+    expect((adapter.requests[0].data as Map)['acceptsStudyParticipation'], isTrue);
+  });
+
+  test('credenciales incorrectas: 401 con mensaje y sin token guardado', () async {
+    adapter.routes['POST /auth/login'] = (401, null);
+    await expectLater(
+      repo.login(email: 'x@y.invalid', password: 'incorrecta'),
+      throwsA(isA<ApiException>().having((e) => e.message, 'message', 'Correo o contraseña incorrectos.')),
+    );
+    expect(await TokenStorage.getToken(), isNull);
+  });
+
+  test('recuperación de contraseña: no llama a endpoints inexistentes', () async {
+    await expectLater(repo.forgotPassword('a@b.invalid'), throwsA(isA<ApiException>()));
+    expect(adapter.requests, isEmpty);
+  });
+
+  test('logout borra el token', () async {
+    await TokenStorage.saveToken('t');
+    await repo.logout();
+    expect(await TokenStorage.getToken(), isNull);
+  });
+}
diff --git a/test/unit/contract_models_test.dart b/test/unit/contract_models_test.dart

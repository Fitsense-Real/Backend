+
+AdaptationOutcome outcome(String resultado, {int? planId = 2, List<String> motivos = const []}) =>
+    AdaptationOutcome(resultado: resultado, resultingPlanId: planId, motivos: motivos);
+
+void main() {
+  group('Mensajes por resultado (AdaptationOutcome.resultado del backend)', () {
+    const cases = {
+      'CONSERVACION_DELIBERADA': AdaptationMessages.kept,
+      'SIN_CAMBIOS_VALIDOS': AdaptationMessages.kept,
+      'ACORTAMIENTO_IMPOSIBLE': AdaptationMessages.kept,
+      'REPROGRAMACION_IMPOSIBLE': AdaptationMessages.kept,
+      'ADAPTACION_IMPOSIBLE': AdaptationMessages.kept,
+      'RESPALDO_PROPUESTA_IA_INVALIDA': AdaptationMessages.kept,
+      'RESPALDO_SIN_IA': AdaptationMessages.kept,
+      'SIN_ADAPTACION': AdaptationMessages.kept,
+      'ADAPTACION_APLICADA': AdaptationMessages.adjusted,
+      'REGENERACION_SEGURA_SUSTITUCION': AdaptationMessages.safety,
+      'REGENERACION_SEGURA_REGLAS': AdaptationMessages.safety,
+      'NO_FACTIBLE': AdaptationMessages.notFeasible,
+      'NO_FACTIBLE_POR_SEGURIDAD': AdaptationMessages.notFeasible,
+      'PROGRESION_DEL_BACKEND': AdaptationMessages.progression,
+    };
+    cases.forEach((resultado, title) {
+      test(resultado, () => expect(AdaptationMessages.of(outcome(resultado)).title, title));
+    });
+
+    test('un resultado desconocido no se interpreta', () {
+      final m = AdaptationMessages.of(outcome('ALGO_NUEVO'));
+      expect(m.kind, AdaptationMessageKind.unknown);
+      expect(m.technicalDetail, contains('Resultado: ALGO_NUEVO'));
+    });
+
+    test('el motivo técnico va al detalle, no al título', () {
+      final m = AdaptationMessages.of(outcome('NO_FACTIBLE_POR_SEGURIDAD',
+          planId: null, motivos: ['P-03: sin alternativa segura valida: [1373]']));
+      expect(m.title, isNot(contains('1373')));
+      expect(m.technicalDetail.last, contains('1373'));
+    });
+  });
+
+  group('Situación del plan', () {
+    test('sin plan y sin historial: generar el primero', () {
+      expect(PlanStatus.resolve(current: null, adaptations: const [], hasAnyPlan: false).situation,
+          PlanSituation.noPlanYet);
+    });
+
+    test('sin plan activo y último ciclo NO_FACTIBLE sin plan publicado', () {
+      final s = PlanStatus.resolve(
+          current: null, adaptations: [outcome('ADAPTACION_APLICADA'), outcome('NO_FACTIBLE', planId: null)], hasAnyPlan: true);
+      expect(s.situation, PlanSituation.notFeasible);
+    });
+
+    test('NO_FACTIBLE resuelto por P-03 nivel 2 (con plan) no es «sin plan»', () {
+      final s = PlanStatus.resolve(
+          current: null, adaptations: [outcome('REGENERACION_SEGURA_REGLAS', planId: 7)], hasAnyPlan: true);
+      expect(s.situation, PlanSituation.waitingCycle);
+    });
+  });
+}

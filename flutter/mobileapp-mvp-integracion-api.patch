@@ -0,0 +1,41 @@
+import '../../data/models/adaptation_outcome.dart';
+import '../../data/models/weekly_plan.dart';
+
+/// Situación del usuario respecto a su plan, calculada solo con lo que devuelve la API.
+enum PlanSituation {
+  /// Hay plan activo.
+  active,
+
+  /// No hay plan y nunca se ha generado: puede generar el primero.
+  noPlanYet,
+
+  /// No hay plan activo y el último ciclo fue NO_FACTIBLE (no publicó semana).
+  notFeasible,
+
+  /// No hay plan activo por otra razón (p. ej., la semana cerró y el ciclo aún no corrió).
+  waitingCycle,
+}
+
+class PlanStatus {
+  final PlanSituation situation;
+  final WeeklyPlan? plan;
+  final AdaptationOutcome? lastAdaptation;
+
+  const PlanStatus(this.situation, {this.plan, this.lastAdaptation});
+
+  static PlanStatus resolve({
+    required WeeklyPlan? current,
+    required List<AdaptationOutcome> adaptations,
+    required bool hasAnyPlan,
+  }) {
+    final last = adaptations.isEmpty ? null : adaptations.last;
+    if (current != null) return PlanStatus(PlanSituation.active, plan: current, lastAdaptation: current.adaptation);
+    if (last != null &&
+        last.resultingPlanId == null &&
+        (last.resultado == 'NO_FACTIBLE' || last.resultado == 'NO_FACTIBLE_POR_SEGURIDAD')) {
+      return PlanStatus(PlanSituation.notFeasible, lastAdaptation: last);
+    }
+    if (!hasAnyPlan) return const PlanStatus(PlanSituation.noPlanYet);
+    return PlanStatus(PlanSituation.waitingCycle, lastAdaptation: last);
+  }
+}

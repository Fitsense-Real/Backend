+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final status = ref.watch(planStatusProvider);
+    return FSPageScaffold(
+      title: 'Mi plan semanal',
+      onRefresh: () async => ref.invalidate(planStatusProvider),
+      body: FSAsyncView<PlanStatus>(
+        value: status,
+        onRetry: () => ref.invalidate(planStatusProvider),
+        builder: (s) => switch (s.situation) {
+          PlanSituation.active => _ActivePlan(plan: s.plan!),
+          PlanSituation.noPlanYet => const _GenerateFirstPlan(),
+          PlanSituation.notFeasible => _NotFeasible(status: s),
+          PlanSituation.waitingCycle => const _WaitingCycle(),
+        },
+      ),
+    );
+  }
+}
+
+String _date(DateTime d) => '${d.day}/${d.month}';
+
+class _ActivePlan extends StatelessWidget {
+  final WeeklyPlan plan;
+
+  const _ActivePlan({required this.plan});
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = Theme.of(context);
+    final guidance = plan.effortGuidance;
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Text('Semana ${plan.weekNumber}', style: theme.textTheme.headlineSmall),
+        Text('Del ${_date(plan.weekStartDate)} al ${_date(plan.weekEndDate)} · ${plan.workouts.length} sesiones',
+            style: theme.textTheme.bodyMedium),
+        const SizedBox(height: 12),
+        if (plan.adaptation != null) AdaptationBanner(outcome: plan.adaptation!),
+        ...plan.workouts.map((w) => _WorkoutTile(workout: w)),
+        if (guidance != null) ...[
+          const SizedBox(height: 12),
+          Card(
+            child: Padding(
+              padding: const EdgeInsets.all(16),
+              child: Column(
+                crossAxisAlignment: CrossAxisAlignment.start,
+                children: [
+                  Text('Cómo dosificar el esfuerzo', style: theme.textTheme.titleMedium),
+                  const SizedBox(height: 8),
+                  for (final t in [guidance.setsRepsText, guidance.durationText, guidance.loadText])
+                    if (t != null && t.isNotEmpty)
+                      Padding(padding: const EdgeInsets.only(bottom: 6), child: Text(t)),
+                ],
+              ),
+            ),
+          ),
+        ],
+      ],
+    );
+  }
+}
+
+class _WorkoutTile extends StatelessWidget {
+  final PlannedWorkout workout;
+
+  const _WorkoutTile({required this.workout});
+
+  @override
+  Widget build(BuildContext context) {
+    final day = FitSenseLabels.weekdays[workout.scheduledDate.weekday] ?? '';
+    final minutes = workout.expectedDurationMinutes == null ? '' : ' · ~${workout.expectedDurationMinutes} min';
+    return Card(
+      child: ListTile(
+        title: Text(workout.workoutName),
+        subtitle: Text('$day ${_date(workout.scheduledDate)} · ${workout.exercises.length} ejercicios$minutes'),
+        trailing: Chip(label: Text(FitSenseLabels.of(FitSenseLabels.workoutStatus, workout.status))),
+        onTap: () => context.push(AppRoutes.workoutDetail(workout.plannedWorkoutId)),
+      ),
+    );
+  }
+}
+
+class _GenerateFirstPlan extends ConsumerStatefulWidget {
+  const _GenerateFirstPlan();
+
+  @override
+  ConsumerState<_GenerateFirstPlan> createState() => _GenerateFirstPlanState();
+}
+
+class _GenerateFirstPlanState extends ConsumerState<_GenerateFirstPlan> {
+  bool _loading = false;
+
+  Future<void> _generate() async {
+    setState(() => _loading = true);
+    try {
+      await ref.read(planRepositoryProvider).generate();
+      ref.invalidate(planStatusProvider);
+    } on ApiException catch (e) {
+      // Sin semana válida (o sin perfil) el backend explica el motivo: se muestra tal cual.
+      if (mounted) showFSMessage(context, e.fullMessage, error: true);
+    } finally {
+      if (mounted) setState(() => _loading = false);
+    }
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final profile = ref.watch(profileProvider);
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Text('Todavía no tienes un plan', style: Theme.of(context).textTheme.headlineSmall),
+        const SizedBox(height: 8),
+        const Text('Prepararemos tu semana con tu perfil, tus días disponibles y tus restricciones.'),
+        const SizedBox(height: 20),
+        FSAsyncView(
+          value: profile,
+          onRetry: () => ref.invalidate(profileProvider),
+          builder: (p) => p == null
+              ? FSButton(text: 'Completar mi perfil', onPressed: () => context.go(AppRoutes.profile))
+              : FSButton(text: 'Generar mi plan', isLoading: _loading, onPressed: _generate),
+        ),
+      ],
+    );

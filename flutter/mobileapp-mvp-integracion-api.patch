index 0000000..938365e
--- /dev/null
+++ b/test/unit/contract_models_test.dart
@@ -0,0 +1,214 @@
+import 'package:dio/dio.dart';
+import 'package:fitsense_mobile/core/api/api_exception.dart';
+import 'package:fitsense_mobile/features/authentication/data/models/authenticated_user_response.dart';
+import 'package:fitsense_mobile/features/authentication/data/models/register_request.dart';
+import 'package:fitsense_mobile/features/authentication/data/models/user_response.dart';
+import 'package:fitsense_mobile/features/plan/data/models/weekly_plan.dart';
+import 'package:fitsense_mobile/features/profile/data/models/user_profile.dart';
+import 'package:fitsense_mobile/features/progress/data/models/progress_models.dart';
+import 'package:fitsense_mobile/features/workout/data/models/workout_session.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+import '../support/fixtures.dart';
+
+/// Los modelos leen las respuestas REALES del backend (capturadas en local).
+void main() {
+  group('Autenticación', () {
+    test('login devuelve userId y token en la raíz (no un objeto user)', () {
+      final r = AuthenticatedUserResponse.fromJson(fixtureMap('login'));
+      expect(r.userId, 1);
+      expect(r.token, 'token-de-prueba-no-valido');
+      expect(r.fullName, 'Ana Prueba');
+      expect(r.role, 'USER');
+    });
+
+    test('register y users/me devuelven UserResource con userId', () {
+      for (final name in ['register', 'me']) {
+        final u = UserResponse.fromJson(fixtureMap(name));
+        expect(u.userId, 1);
+        expect(u.firstName, 'Ana');
+        expect(u.timezone, 'America/Lima');
+        expect(u.studyParticipant, isTrue);
+      }
+    });
+
+    test('lastName puede venir nulo', () {
+      final json = {...fixtureMap('me'), 'lastName': null};
+      expect(UserResponse.fromJson(json).lastName, isNull);
+    });
+
+    test('el registro envía el consentimiento y omite la zona horaria si no se conoce', () {
+      final body = const RegisterRequest(
+        firstName: 'Ana',
+        lastName: 'Prueba',
+        email: 'a@b.invalid',
+        password: 'ClaveSegura123',
+        acceptsStudyParticipation: false,
+      ).toJson();
+      expect(body['acceptsStudyParticipation'], isFalse);
+      expect(body.containsKey('timezone'), isFalse);
+    });
+  });
+
+  group('Perfil', () {
+    test('lee el perfil real', () {
+      final p = UserProfile.fromJson(fixtureMap('profile'));
+      expect(p.goalType, 'GENERAL_FITNESS');
+      expect(p.availableDays, [1, 3, 5]);
+      expect(p.sessionMinutes, 45);
+      expect(p.equipmentCodes, contains('dumbbell'));
+      expect(p.allowOverheadExercises, isTrue);
+    });
+
+    test('daysPerWeek se deriva de los días elegidos; birthDate solo al crear', () {
+      final r = ProfileRequest(
+        birthDate: DateTime(1995, 5, 10),
+        heightCm: 165,
+        currentWeightKg: 62,
+        fitnessLevel: 'INTERMEDIATE',
+        goalType: 'GENERAL_FITNESS',
+        goalText: 'Sentirme mejor',
+        trainingLocation: 'GYM',
+        availableDays: [5, 1, 3],
+        sessionMinutes: 45,
+        equipmentCodes: ['body weight'],
+      );
+      final create = r.toJson(forCreate: true);
+      expect(create['birthDate'], '1995-05-10');
+      expect(create['daysPerWeek'], 3);
+      expect(create['availableDays'], [1, 3, 5]);
+      expect(r.toJson(forCreate: false).containsKey('birthDate'), isFalse);
+    });
+
+    test('catálogo de equipamiento ordenado por displayOrder', () {
+      final list = fixtureList('equipment').map((e) => EquipmentType.fromJson(e as Map<String, dynamic>)).toList();
+      expect(list.first.code, 'body weight');
+      expect(list.first.nameEs, 'Peso corporal');
+    });
+  });
+
+  group('Plan semanal', () {
+    final plan = WeeklyPlan.fromJson(fixtureMap('plan_current'));
+
+    test('lee el plan generado por el motor de reglas', () {
+      expect(plan.planId, 1);
+      expect(plan.generationSource, 'RULE_ENGINE');
+      expect(plan.workouts, hasLength(3));
+      expect(plan.adaptation, isNull);
+      expect(plan.effortGuidance?.repsInReserve, '2-3');
+      expect(plan.workouts.first.expiresAt, isNotNull);
+    });
+
+    test('dosis por repeticiones y por tiempo, sin convertir entre ellas', () {
+      final all = plan.workouts.expand((w) => w.exercises).toList();
+      final reps = all.firstWhere((e) => e.prescriptionType == 'SETS_REPS');
+      final secs = all.firstWhere((e) => e.prescriptionType == 'DURATION');
+      expect(reps.doseText, '${reps.plannedSets} × ${reps.plannedReps}');
+      expect(secs.doseText, '${secs.plannedSets} × ${secs.plannedDurationSeconds} s');
+      expect(reps.restText, startsWith('Descanso'));
+    });
+
+    test('caducidad: solo informa con expiresAt del backend', () {
+      final w = plan.workouts.first;
+      expect(w.isExpired(w.expiresAt!.subtract(const Duration(minutes: 1))), isFalse);
+      expect(w.isExpired(w.expiresAt!.add(const Duration(minutes: 1))), isTrue);
+    });
+
+    test('historial de planes', () {
+      final s = PlanSummary.fromJson(fixtureList('plans').first as Map<String, dynamic>);
+      expect(s.status, 'ACTIVE');
+      expect(s.plannedDaysCount, 3);
+    });
+  });
+
+  group('Ejecución', () {
+    test('inicio de sesión (futura: no cuenta para la adherencia)', () {
+      final s = WorkoutSession.fromJson(fixtureMap('session_start'));
+      expect(s.isInProgress, isTrue);
+      expect(s.countsTowardAdherence, isFalse);
+      expect(s.exercises, isEmpty);
+    });
+
+    test('fin de sesión con un ejercicio omitido por dolor', () {
+      final s = WorkoutSession.fromJson(fixtureMap('session_finish'));
+      expect(s.status, 'COMPLETED');
+      expect(s.completionPercentage, closeTo(83.33, 0.001));
+      expect(s.recordFor(1)!.hadPain, isTrue);
+      expect(s.recordFor(5)!.actualDurationSeconds, 360);
+    });
+
+    test('omitir: contexto y minutos solo con falta de tiempo', () {
+      expect(const SkipWorkoutRequest(reason: 'FATIGUE', lackOfTimeContext: 'IMPREVISTO').toJson(),
+          {'reason': 'FATIGUE'});
+      expect(
+        const SkipWorkoutRequest(
+                reason: 'LACK_OF_TIME', lackOfTimeContext: 'MENOS_TIEMPO_HABITUAL', availableMinutes: 30)
+            .toJson(),
+        {'reason': 'LACK_OF_TIME', 'lackOfTimeContext': 'MENOS_TIEMPO_HABITUAL', 'availableMinutes': 30},
+      );
+    });
+
+    test('fin: el RPE es obligatorio y lo opcional no se envía vacío', () {
+      expect(const FinishSessionRequest(sessionRpe: 6).toJson(), {'sessionRpe': 6});
+    });
+  });
+
+  group('Seguimiento', () {
+    test('métricas de una semana sin plan (antes del primero)', () {
+      final m = WeeklyMetrics.fromJson(fixtureList('metrics').first as Map<String, dynamic>);
+      expect(m.hasActivePlan, isFalse);
+      expect(m.weightedAdherencePct, isNull);
+      expect(m.scheduledWorkouts, 0);
+    });
+
+    test('exclusión por dolor activa', () {
+      final p = PainExclusion.fromJson({
+        'exclusionId': 3,
+        'exerciseId': 755,
+        'exerciseName': 'Sentadilla con mancuerna',
+        'reason': 'PAIN_OR_DISCOMFORT',
+        'eventDate': '2026-11-02',
+        'sourcePlannedWorkoutId': 1,
+        'status': 'ACTIVA',
+        'recordedAt': '2026-11-09T08:00:00Z',
+        'reactivatedAt': null,
+      });
+      expect(p.isActive, isTrue);
+    });
+  });
+
+  group('Errores', () {
+    ApiException fromBody(int status, Object? body) => ApiException.fromDio(DioException(
+          requestOptions: RequestOptions(path: '/x'),
+          response: Response(requestOptions: RequestOptions(path: '/x'), statusCode: status, data: body),
+        ));
+
+    test('422 de rango de minutos: se muestra el texto del backend (rango por objetivo)', () {
+      final e = fromBody(422, fixtureMap('profile_invalido'));
+      expect(e.isDomainRule, isTrue);
+      expect(e.message, contains('entre 30 y 75 minutos'));
+    });
+
+    test('422 de perfil congelado tras el primer plan', () {
+      expect(fromBody(422, fixtureMap('profile_put_after_plan')).message, contains('no se puede modificar'));
+    });
+
+    test('404 de perfil inexistente', () {
+      expect(fromBody(404, fixtureMap('profile_404')).isNotFound, isTrue);
+    });
+
+    test('400 de validación incluye los detalles', () {
+      final e = fromBody(400, {
+        'status': 400,
+        'message': 'La solicitud tiene campos invalidos.',
+        'details': ['sessionRpe: Indica el esfuerzo percibido de la sesion, de 1 a 10.'],
+      });
+      expect(e.fullMessage, contains('sessionRpe'));
+    });
+
+    test('sin respuesta: error de conexión', () {
+      final e = ApiException.fromDio(DioException(requestOptions: RequestOptions(path: '/x')));
+      expect(e.isNetwork, isTrue);
+    });
+  });
+}

+/// `AdaptationOutcome` (`GET /users/me/plan/adaptations` y `WeeklyPlan.adaptation`).
+///
+/// Traduce lo que V32 registró en el ciclo semanal; la app no decide nada a partir
+/// de él, solo elige el mensaje (ver `adaptation_messages.dart`).
+class AdaptationOutcome {
+  final int? attemptId;
+  final DateTime? weekStartDate;
+
+  /// Plan publicado por el ciclo; `null` si no se publicó ninguno (NO_FACTIBLE).
+  final int? resultingPlanId;
+  final String resultado;
+  final String? estado;
+  final String? decision;
+  final int llamadasIa;
+
+  /// Texto técnico del backend. Se muestra como detalle, nunca como diagnóstico.
+  final List<String> motivos;
+  final List<AdaptedSession> sesiones;
+
+  const AdaptationOutcome({
+    this.attemptId,
+    this.weekStartDate,
+    this.resultingPlanId,
+    required this.resultado,
+    this.estado,
+    this.decision,
+    this.llamadasIa = 0,
+    this.motivos = const [],
+    this.sesiones = const [],
+  });
+
+  factory AdaptationOutcome.fromJson(Map<String, dynamic> json) {
+    return AdaptationOutcome(
+      attemptId: (json['attemptId'] as num?)?.toInt(),
+      weekStartDate: json['weekStartDate'] == null ? null : DateTime.parse(json['weekStartDate'] as String),
+      resultingPlanId: (json['resultingPlanId'] as num?)?.toInt(),
+      resultado: (json['resultado'] as String?) ?? '',
+      estado: json['estado'] as String?,
+      decision: json['decision'] as String?,
+      llamadasIa: (json['llamadasIa'] as num?)?.toInt() ?? 0,
+      motivos: ((json['motivos'] as List?) ?? const []).map((m) => m.toString()).toList(),
+      sesiones: ((json['sesiones'] as List?) ?? const [])
+          .map((s) => AdaptedSession.fromJson(s as Map<String, dynamic>))
+          .toList(),
+    );
+  }
+}
+
+class AdaptedSession {
+  final int? origenPlannedWorkoutId;
+  final String? intervencion;
+  final String? resultado;
+
+  const AdaptedSession({this.origenPlannedWorkoutId, this.intervencion, this.resultado});
+
+  factory AdaptedSession.fromJson(Map<String, dynamic> json) {
+    return AdaptedSession(
+      origenPlannedWorkoutId: (json['origenPlannedWorkoutId'] as num?)?.toInt(),
+      intervencion: json['intervencion'] as String?,
+      resultado: json['resultado'] as String?,
+    );
+  }
+}
diff --git a/lib/features/plan/data/models/weekly_plan.dart b/lib/features/plan/data/models/weekly_plan.dart
new file mode 100644
index 0000000..ea05fb6
--- /dev/null
+++ b/lib/features/plan/data/models/weekly_plan.dart
@@ -0,0 +1,279 @@
+/// Modelos de `WeeklyTrainingPlanResource` (`/users/me/plan/*`).
+///
+/// No se modela la duración estimada por contenido (`DurationInfoResource`):
+/// solo existe en el PR #17, detrás de un indicador apagado. Se usa
+/// `expectedDurationMinutes`, que sí forma parte del contrato activo.
+library;
+
+import 'adaptation_outcome.dart';
+
+DateTime _date(Object v) => DateTime.parse(v as String);
+DateTime? _dateOrNull(Object? v) => v == null ? null : DateTime.parse(v as String);
+int? _intOrNull(Object? v) => (v as num?)?.toInt();
+
+class WeeklyPlan {
+  final int planId;
+  final int weekNumber;
+  final DateTime weekStartDate;
+  final DateTime weekEndDate;
+  final int planVersion;
+  final int? parentPlanId;
+  final int plannedDaysCount;
+  final String status;
+  final String? generationSource;
+  final String? adjustmentApplied;
+  final String? adjustmentReason;
+  final DateTime? activatedAt;
+  final List<PlannedWorkout> workouts;
+  final EffortGuidance? effortGuidance;
+
+  /// Qué pasó en el ciclo que publicó este plan; `null` en la generación inicial.
+  final AdaptationOutcome? adaptation;
+
+  const WeeklyPlan({
+    required this.planId,
+    required this.weekNumber,
+    required this.weekStartDate,
+    required this.weekEndDate,
+    required this.planVersion,
+    this.parentPlanId,
+    required this.plannedDaysCount,
+    required this.status,
+    this.generationSource,
+    this.adjustmentApplied,
+    this.adjustmentReason,
+    this.activatedAt,
+    required this.workouts,
+    this.effortGuidance,
+    this.adaptation,
+  });
+
+  factory WeeklyPlan.fromJson(Map<String, dynamic> json) {
+    final workouts = ((json['workouts'] as List?) ?? const [])
+        .map((w) => PlannedWorkout.fromJson(w as Map<String, dynamic>))
+        .toList()
+      ..sort((a, b) => a.displayOrder.compareTo(b.displayOrder));
+    return WeeklyPlan(
+      planId: (json['planId'] as num).toInt(),
+      weekNumber: (json['weekNumber'] as num).toInt(),
+      weekStartDate: _date(json['weekStartDate']),
+      weekEndDate: _date(json['weekEndDate']),
+      planVersion: (json['planVersion'] as num?)?.toInt() ?? 1,
+      parentPlanId: _intOrNull(json['parentPlanId']),
+      plannedDaysCount: (json['plannedDaysCount'] as num?)?.toInt() ?? workouts.length,
+      status: json['status'] as String,
+      generationSource: json['generationSource'] as String?,
+      adjustmentApplied: json['adjustmentApplied'] as String?,
+      adjustmentReason: json['adjustmentReason'] as String?,
+      activatedAt: _dateOrNull(json['activatedAt']),
+      workouts: workouts,
+      effortGuidance: json['effortGuidance'] == null
+          ? null
+          : EffortGuidance.fromJson(json['effortGuidance'] as Map<String, dynamic>),
+      adaptation: json['adaptation'] == null
+          ? null
+          : AdaptationOutcome.fromJson(json['adaptation'] as Map<String, dynamic>),
+    );
+  }
+
+  PlannedWorkout? workoutById(int plannedWorkoutId) {
+    for (final w in workouts) {
+      if (w.plannedWorkoutId == plannedWorkoutId) return w;
+    }
+    return null;
+  }
+}
+
+class PlannedWorkout {
+  final int plannedWorkoutId;
+  final DateTime scheduledDate;
+  final String? focusCode;
+  final String workoutName;
+  final int? expectedDurationMinutes;
+  final int displayOrder;
+  final String status;
+  final String? skipReason;
+
+  /// Último instante (UTC) en que se puede iniciar: 23:59 local del día.
+  final DateTime? expiresAt;
+  final List<PlannedExercise> exercises;
+  final bool safetyBlocked;
+  final String? safetyBlockMessage;
+
+  const PlannedWorkout({
+    required this.plannedWorkoutId,
+    required this.scheduledDate,
+    this.focusCode,
+    required this.workoutName,
+    this.expectedDurationMinutes,
+    required this.displayOrder,
+    required this.status,
+    this.skipReason,
+    this.expiresAt,
+    required this.exercises,
+    this.safetyBlocked = false,
+    this.safetyBlockMessage,
+  });
+
+  factory PlannedWorkout.fromJson(Map<String, dynamic> json) {
+    final exercises = ((json['exercises'] as List?) ?? const [])
+        .map((e) => PlannedExercise.fromJson(e as Map<String, dynamic>))
+        .toList()
+      ..sort((a, b) => a.exerciseOrder.compareTo(b.exerciseOrder));
+    return PlannedWorkout(
+      plannedWorkoutId: (json['plannedWorkoutId'] as num).toInt(),
+      scheduledDate: _date(json['scheduledDate']),
+      focusCode: json['focusCode'] as String?,
+      workoutName: (json['workoutName'] as String?) ?? 'Entrenamiento',
+      expectedDurationMinutes: _intOrNull(json['expectedDurationMinutes']),
+      displayOrder: (json['displayOrder'] as num?)?.toInt() ?? 0,
+      status: json['status'] as String,
+      skipReason: json['skipReason'] as String?,
+      expiresAt: _dateOrNull(json['expiresAt']),
+      exercises: exercises,
+      safetyBlocked: (json['safetyBlocked'] as bool?) ?? false,
+      safetyBlockMessage: json['safetyBlockMessage'] as String?,
+    );
+  }
+
+  bool get isPending => status == 'SCHEDULED' || status == 'IN_PROGRESS';
+
+  /// Ya no se puede iniciar (pasó `expiresAt`). La app no cambia fechas: solo informa.
+  bool isExpired(DateTime nowUtc) => expiresAt != null && nowUtc.isAfter(expiresAt!);
+}
+
+class PlannedExercise {
+  final int plannedExerciseId;
+  final int exerciseId;
+  final String exerciseName;
+  final String? targetMuscle;
+  final String? bodyPart;
+  final String? equipment;
+  final int? difficultyLevel;
+  final int exerciseOrder;
+
+  /// `SETS_REPS` o `DURATION`.
+  final String prescriptionType;
+  final int? plannedSets;
+  final int? plannedReps;
+  final int? plannedDurationSeconds;
+  final double? targetLoadKg;
+  final int? restSeconds;
+  final String? notes;
+  final String? gifPath;
+  final String? imagePath;
+  final String? mediaAttribution;
+  final String? safetyBlockReason;
+
+  const PlannedExercise({
+    required this.plannedExerciseId,
+    required this.exerciseId,
+    required this.exerciseName,
+    this.targetMuscle,
+    this.bodyPart,
+    this.equipment,
+    this.difficultyLevel,
+    required this.exerciseOrder,
+    required this.prescriptionType,
+    this.plannedSets,
+    this.plannedReps,
+    this.plannedDurationSeconds,
+    this.targetLoadKg,
+    this.restSeconds,
+    this.notes,
+    this.gifPath,
+    this.imagePath,
+    this.mediaAttribution,
+    this.safetyBlockReason,
+  });
+
+  factory PlannedExercise.fromJson(Map<String, dynamic> json) {
+    return PlannedExercise(
+      plannedExerciseId: (json['plannedExerciseId'] as num).toInt(),
+      exerciseId: (json['exerciseId'] as num).toInt(),
+      exerciseName: (json['exerciseName'] as String?) ?? 'Ejercicio',
+      targetMuscle: json['targetMuscle'] as String?,
+      bodyPart: json['bodyPart'] as String?,
+      equipment: json['equipment'] as String?,
+      difficultyLevel: _intOrNull(json['difficultyLevel']),
+      exerciseOrder: (json['exerciseOrder'] as num?)?.toInt() ?? 0,
+      prescriptionType: (json['prescriptionType'] as String?) ?? 'SETS_REPS',
+      plannedSets: _intOrNull(json['plannedSets']),
+      plannedReps: _intOrNull(json['plannedReps']),
+      plannedDurationSeconds: _intOrNull(json['plannedDurationSeconds']),
+      targetLoadKg: (json['targetLoadKg'] as num?)?.toDouble(),
+      restSeconds: _intOrNull(json['restSeconds']),
+      notes: json['notes'] as String?,
+      gifPath: json['gifPath'] as String?,
+      imagePath: json['imagePath'] as String?,
+      mediaAttribution: json['mediaAttribution'] as String?,
+      safetyBlockReason: json['safetyBlockReason'] as String?,
+    );
+  }
+
+  bool get isDuration => prescriptionType == 'DURATION';
+
+  /// «3 × 12» o «3 × 45 s», tal como lo prescribe el backend (sin convertir).
+  String get doseText {
+    final sets = plannedSets ?? 1;
+    if (isDuration) return '$sets × ${plannedDurationSeconds ?? '—'} s';
+    return '$sets × ${plannedReps ?? '—'}';
+  }
+
+  String? get restText => restSeconds == null ? null : 'Descanso ${restSeconds!} s';
+}
+
+/// Guía de esfuerzo de la semana (RIR y textos), tal como la redacta el backend.
+class EffortGuidance {
+  final String? repsInReserve;
+  final String? setsRepsText;
+  final String? durationText;
+  final String? loadText;
+
+  const EffortGuidance({this.repsInReserve, this.setsRepsText, this.durationText, this.loadText});
+
+  factory EffortGuidance.fromJson(Map<String, dynamic> json) {
+    return EffortGuidance(
+      repsInReserve: json['repsInReserve'] as String?,
+      setsRepsText: json['setsRepsText'] as String?,
+      durationText: json['durationText'] as String?,
+      loadText: json['loadText'] as String?,
+    );
+  }
+}
+
+/// `PlanSummaryResource` de `GET /users/me/plans`.
+class PlanSummary {
+  final int planId;
+  final int weekNumber;
+  final DateTime weekStartDate;
+  final DateTime weekEndDate;
+  final int planVersion;
+  final int plannedDaysCount;
+  final String status;
+  final String? generationSource;
+
+  const PlanSummary({
+    required this.planId,
+    required this.weekNumber,
+    required this.weekStartDate,
+    required this.weekEndDate,
+    required this.planVersion,
+    required this.plannedDaysCount,
+    required this.status,
+    this.generationSource,
+  });
+
+  factory PlanSummary.fromJson(Map<String, dynamic> json) {
+    return PlanSummary(
+      planId: (json['planId'] as num).toInt(),
+      weekNumber: (json['weekNumber'] as num).toInt(),
+      weekStartDate: _date(json['weekStartDate']),
+      weekEndDate: _date(json['weekEndDate']),
+      planVersion: (json['planVersion'] as num?)?.toInt() ?? 1,
+      plannedDaysCount: (json['plannedDaysCount'] as num?)?.toInt() ?? 0,
+      status: json['status'] as String,
+      generationSource: json['generationSource'] as String?,
+    );
+  }
+}

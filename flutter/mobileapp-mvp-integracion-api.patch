+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../../../core/providers/dio_provider.dart';
+import '../../data/datasource/plan_remote_datasource.dart';
+import '../../data/models/adaptation_outcome.dart';
+import '../../data/repositories/plan_repository_impl.dart';
+import '../../domain/repositories/plan_repository.dart';
+import '../../domain/services/plan_status.dart';
+
+final planRepositoryProvider = Provider<PlanRepository>((ref) {
+  return PlanRepositoryImpl(PlanRemoteDataSource(ref.read(dioProvider)));
+});
+
+final adaptationsProvider = FutureProvider.autoDispose<List<AdaptationOutcome>>((ref) {
+  return ref.read(planRepositoryProvider).adaptations();
+});
+
+/// Plan actual + situación (activo, sin plan, NO_FACTIBLE, esperando el ciclo).
+final planStatusProvider = FutureProvider.autoDispose<PlanStatus>((ref) async {
+  final repo = ref.read(planRepositoryProvider);
+  final current = await repo.current();
+  if (current != null) return PlanStatus.resolve(current: current, adaptations: const [], hasAnyPlan: true);
+  final results = await Future.wait([repo.adaptations(), repo.plans()]);
+  return PlanStatus.resolve(
+    current: null,
+    adaptations: results[0] as List<AdaptationOutcome>,
+    hasAnyPlan: (results[1] as List).isNotEmpty,
+  );
+});

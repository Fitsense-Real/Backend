+import 'package:fitsense_mobile/features/plan/data/models/adaptation_outcome.dart';
+import 'package:fitsense_mobile/features/plan/domain/services/adaptation_messages.dart';
+import 'package:fitsense_mobile/features/plan/presentation/widgets/adaptation_banner.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  testWidgets('NO_FACTIBLE: mensaje claro, ayuda y detalle técnico plegado', (tester) async {
+    await tester.pumpWidget(const MaterialApp(
+      home: Scaffold(
+        body: AdaptationBanner(
+          outcome: AdaptationOutcome(
+            resultado: 'NO_FACTIBLE_POR_SEGURIDAD',
+            motivos: ['P-03: sin alternativa segura valida: [1373]'],
+          ),
+        ),
+      ),
+    ));
+    expect(find.text(AdaptationMessages.notFeasible), findsOneWidget);
+    expect(find.text(AdaptationMessages.notFeasibleHelp), findsOneWidget);
+    expect(find.textContaining('1373'), findsNothing);
+
+    await tester.tap(find.text(AdaptationMessages.notFeasible));
+    await tester.pumpAndSettle();
+    expect(find.textContaining('1373'), findsOneWidget);
+  });
+
+  testWidgets('sustitución por seguridad', (tester) async {
+    await tester.pumpWidget(const MaterialApp(
+      home: Scaffold(body: AdaptationBanner(outcome: AdaptationOutcome(resultado: 'REGENERACION_SEGURA_SUSTITUCION'))),
+    ));
+    expect(find.text(AdaptationMessages.safety), findsOneWidget);
+  });
+}

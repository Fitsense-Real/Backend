diff --git a/lib/core/api/api_exception.dart b/lib/core/api/api_exception.dart
new file mode 100644
index 0000000..5c9950a
--- /dev/null
+++ b/lib/core/api/api_exception.dart
@@ -0,0 +1,70 @@
+import 'package:dio/dio.dart';
+
+/// Error de la API con el cuerpo `ApiErrorResource` del backend
+/// (`{timestamp, status, error, message, details}`).
+///
+/// [message] se muestra tal cual: el backend ya redacta en español los
+/// errores de dominio (por ejemplo, el rango de minutos por objetivo, 422).
+class ApiException implements Exception {
+  final int? statusCode;
+  final String message;
+  final List<String> details;
+
+  const ApiException({this.statusCode, required this.message, this.details = const []});
+
+  bool get isNotFound => statusCode == 404;
+  bool get isDomainRule => statusCode == 422;
+  bool get isUnauthorized => statusCode == 401 || statusCode == 403;
+  bool get isNetwork => statusCode == null;
+
+  /// Mensaje con los detalles de validación (400), si los hay.
+  String get fullMessage => details.isEmpty ? message : '$message\n${details.join('\n')}';
+
+  factory ApiException.fromDio(DioException e) {
+    final status = e.response?.statusCode;
+    final data = e.response?.data;
+    if (data is Map && data['message'] is String && (data['message'] as String).isNotEmpty) {
+      final rawDetails = data['details'];
+      return ApiException(
+        statusCode: status,
+        message: data['message'] as String,
+        details: rawDetails is List ? rawDetails.map((d) => d.toString()).toList() : const [],
+      );
+    }
+    if (status == null) {
+      return const ApiException(
+        message: 'No se pudo conectar con el servidor. Revisa tu conexión e inténtalo de nuevo.',
+      );
+    }
+    return ApiException(statusCode: status, message: _byStatus(status));
+  }
+
+  static String _byStatus(int status) {
+    switch (status) {
+      case 400:
+        return 'La solicitud tiene campos inválidos.';
+      case 401:
+        return 'Correo o contraseña incorrectos.';
+      case 403:
+        return 'Tu sesión ha caducado. Vuelve a iniciar sesión.';
+      case 404:
+        return 'No se encontró el recurso solicitado.';
+      case 409:
+        return 'La operación entra en conflicto con datos existentes.';
+      default:
+        return 'Ha ocurrido un error inesperado.';
+    }
+  }
+
+  @override
+  String toString() => message;
+}
+
+/// Ejecuta una llamada y convierte los errores de Dio en [ApiException].
+Future<T> guardApi<T>(Future<T> Function() call) async {
+  try {
+    return await call();
+  } on DioException catch (e) {
+    throw ApiException.fromDio(e);
+  }
+}

# FitSense · PLANTILLA de variables de PREPRODUCCION en Railway (B4.3). SIN SECRETOS: los valores <...> los pone en el
# panel quien tenga acceso, y los marcados SECRETO solo como variables de Railway (nunca en el repositorio ni en chats).
# No se ha aplicado a ningun servicio. Ver 06_OPERACION_RAILWAY_Y_RESPALDOS.md.

SPRING_PROFILES_ACTIVE=prod
TZ=UTC

# Base AISLADA de preproduccion (nunca la de produccion)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host-preproduccion>/<base>?sslmode=require
SPRING_DATASOURCE_USERNAME=<usuario-preproduccion>
DB_PASSWORD=<SECRETO>

# Sesion: un secreto PROPIO de preproduccion (openssl rand -base64 48)
JWT_SECRET=<SECRETO>

# HTTPS y CORS
FITSENSE_REQUIRE_HTTPS=true
FITSENSE_CORS_ORIGINS=https://<panel-preproduccion>
# Solo si el proxy de Railway no esta en los rangos de confianza de Tomcat (nunca .*):
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=<regex del rango del proxy>

# IA DESACTIVADA en preproduccion (sin coste): sin REPLICATE_API_TOKEN
FITSENSE_AI_ENABLED=false

# Correo (cuando se apruebe el proveedor; 05_CORREO_Y_RECUPERACION.md)
FITSENSE_MAIL_TRANSPORT=none
# FITSENSE_MAIL_TRANSPORT=resend
# FITSENSE_MAIL_FROM=no-responder@<dominio-verificado>
# FITSENSE_MAIL_API_KEY=<SECRETO>
# FITSENSE_PASSWORD_RESET_DELIVERY=email

# Push (solo al probarlo, con un proyecto de Firebase de pruebas)
FITSENSE_PUSH_ENABLED=false
# FITSENSE_FIREBASE_CREDENTIALS_BASE64=<SECRETO>

# Consentimientos: exigencia APAGADA hasta tener documentos aprobados y Mobile coordinado (03_...)
FITSENSE_CONSENT_ENFORCE_ON_SIGNUP=false

# NO definir (se usan los valores aprobados; con B1, otro valor impide arrancar con prod):
#   FITSENSE_DOSE_ENFORCEMENT, FITSENSE_CAPABILITY_ENFORCEMENT, FITSENSE_COVERAGE_ENFORCEMENT,
#   FITSENSE_DIFFICULTY_GUARD, FITSENSE_PAIN_LOCALIZED_REMOVAL, FITSENSE_LOGGING_SENSITIVE_DETAIL,
#   FITSENSE_API_DOCS_ENABLED, FITSENSE_MANUAL_CYCLE_ENABLED

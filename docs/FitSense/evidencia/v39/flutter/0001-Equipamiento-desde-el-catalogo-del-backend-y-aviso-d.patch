@@ -0,0 +1,51 @@
+import 'package:flutter/material.dart';
+
+import '../data/equipment_models.dart';
+
+/// Explica lo que el plan no puede cubrir. El texto viene del backend; la
+/// tarjeta no sugiere comprar nada, solo recuerda que se puede declarar lo
+/// que ya se tiene.
+class PlanLimitationsCard extends StatelessWidget {
+  final List<PlanLimitation> limitations;
+  final Map<String, String> equipmentNames;
+
+  const PlanLimitationsCard({
+    super.key,
+    required this.limitations,
+    this.equipmentNames = const {},
+  });
+
+  @override
+  Widget build(BuildContext context) {
+    if (limitations.isEmpty) return const SizedBox.shrink();
+    final theme = Theme.of(context);
+    return Card(
+      child: Padding(
+        padding: const EdgeInsets.all(16),
+        child: Column(
+          crossAxisAlignment: CrossAxisAlignment.start,
+          children: [
+            for (final l in limitations) ...[
+              Row(children: [
+                const Icon(Icons.info_outline),
+                const SizedBox(width: 8),
+                Expanded(child: Text(l.title, style: theme.textTheme.titleMedium)),
+              ]),
+              const SizedBox(height: 8),
+              Text(l.message),
+              if (l.optionalEquipmentCodes.isNotEmpty) ...[
+                const SizedBox(height: 8),
+                Text(
+                  'Si ya tienes alguno: '
+                  '${l.optionalEquipmentCodes.map((c) => equipmentNames[c] ?? c).join(', ')}.',
+                  style: theme.textTheme.bodySmall,
+                ),
+              ],
+              const SizedBox(height: 12),
+            ],
+          ],
+        ),
+      ),
+    );
+  }
+}

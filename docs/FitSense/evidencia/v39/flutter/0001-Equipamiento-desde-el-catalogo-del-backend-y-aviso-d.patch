+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../../../core/providers/dio_provider.dart';
+import '../data/equipment_models.dart';
+import '../data/equipment_remote_datasource.dart';
+
+final equipmentDataSourceProvider = Provider<EquipmentRemoteDataSource>(
+  (ref) => EquipmentRemoteDataSource(ref.read(dioProvider)),
+);
+
+final equipmentTypesProvider = FutureProvider<List<EquipmentType>>(
+  (ref) async =>
+      sortedForDisplay(await ref.read(equipmentDataSourceProvider).equipmentTypes()),
+);
+
+final profileEquipmentProvider = FutureProvider<List<String>>((ref) async {
+  final profile = await ref.read(equipmentDataSourceProvider).profile();
+  return ((profile['equipmentCodes'] as List?) ?? const []).cast<String>();
+});
+
+final planLimitationsProvider = FutureProvider<List<PlanLimitation>>(
+  (ref) => ref.read(equipmentDataSourceProvider).planLimitations(),
+);

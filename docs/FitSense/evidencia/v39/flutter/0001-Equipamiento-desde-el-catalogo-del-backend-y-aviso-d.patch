+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+
+import '../data/equipment_models.dart';
+import 'equipment_providers.dart';
+import 'plan_limitations_card.dart';
+
+/// Seleccion del equipamiento real. La lista sale del catalogo del backend
+/// (incluye espaldera, punto de anclaje, banco GHD, step...): ningun codigo
+/// esta escrito en la app.
+class EquipmentSelectionPage extends ConsumerStatefulWidget {
+  const EquipmentSelectionPage({super.key});
+
+  @override
+  ConsumerState<EquipmentSelectionPage> createState() =>
+      _EquipmentSelectionPageState();
+}
+
+class _EquipmentSelectionPageState extends ConsumerState<EquipmentSelectionPage> {
+  Set<String>? _seleccion;
+  bool _guardando = false;
+  String? _error;
+
+  @override
+  Widget build(BuildContext context) {
+    final tipos = ref.watch(equipmentTypesProvider);
+    final actuales = ref.watch(profileEquipmentProvider);
+    final limitaciones = ref.watch(planLimitationsProvider);
+
+    return Scaffold(
+      appBar: AppBar(title: const Text('Tu equipamiento')),
+      body: tipos.when(
+        loading: () => const Center(child: CircularProgressIndicator()),
+        error: (e, _) => Center(child: Text('No se pudo cargar el equipamiento.')),
+        data: (lista) {
+          _seleccion ??= actuales.value?.toSet();
+          if (_seleccion == null) {
+            return const Center(child: CircularProgressIndicator());
+          }
+          final nombres = {for (final t in lista) t.code: t.nameEs};
+          return ListView(
+            padding: const EdgeInsets.all(16),
+            children: [
+              const Text('Marca solo lo que ya tienes. El plan se adapta a ello.'),
+              const SizedBox(height: 12),
+              limitaciones.maybeWhen(
+                data: (l) => PlanLimitationsCard(limitations: l, equipmentNames: nombres),
+                orElse: () => const SizedBox.shrink(),
+              ),
+              for (final t in lista) _fila(t),
+              if (_error != null)
+                Padding(
+                  padding: const EdgeInsets.only(top: 8),
+                  child: Text(_error!, style: TextStyle(color: Theme.of(context).colorScheme.error)),
+                ),
+              const SizedBox(height: 16),
+              FilledButton(
+                onPressed: _guardando ? null : _guardar,
+                child: Text(_guardando ? 'Guardando...' : 'Guardar'),
+              ),
+            ],
+          );
+        },
+      ),
+    );
+  }
+
+  Widget _fila(EquipmentType t) => CheckboxListTile(
+        key: ValueKey('equipo-${t.code}'),
+        value: _seleccion!.contains(t.code),
+        title: Text(t.nameEs),
+        subtitle: t.requiresGym ? const Text('Gimnasio') : null,
+        onChanged: (v) => setState(() {
+          if (v == true) {
+            _seleccion!.add(t.code);
+          } else {
+            _seleccion!.remove(t.code);
+          }
+        }),
+      );
+
+  Future<void> _guardar() async {
+    setState(() {
+      _guardando = true;
+      _error = null;
+    });
+    try {
+      final enviados = _seleccion!.toList()..sort();
+      final guardados = await ref.read(equipmentDataSourceProvider).saveEquipment(enviados);
+      // El backend normaliza (minusculas, sin duplicados): se comprueba que no se perdio nada.
+      final perdidos = enviados.where((c) => !guardados.contains(c)).toList();
+      if (perdidos.isNotEmpty) {
+        setState(() => _error = 'No se guardaron: ${perdidos.join(', ')}');
+      }
+      ref.invalidate(profileEquipmentProvider);
+      ref.invalidate(planLimitationsProvider);
+    } catch (_) {
+      setState(() => _error = 'No se pudo guardar. Intentalo de nuevo.');
+    } finally {
+      if (mounted) setState(() => _guardando = false);
+    }
+  }
+}

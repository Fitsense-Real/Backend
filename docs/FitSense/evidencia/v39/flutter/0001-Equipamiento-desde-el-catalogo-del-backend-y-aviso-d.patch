diff --git a/lib/features/equipment/data/equipment_models.dart b/lib/features/equipment/data/equipment_models.dart
new file mode 100644
index 0000000..98d2252
--- /dev/null
+++ b/lib/features/equipment/data/equipment_models.dart
@@ -0,0 +1,73 @@
+/// Un tipo de equipamiento tal como lo publica GET /catalog/equipment-types.
+/// El codigo es el que se guarda en el perfil y usa la generacion del plan.
+class EquipmentType {
+  final String code;
+  final String nameEs;
+  final bool requiresGym;
+  final int displayOrder;
+
+  const EquipmentType({
+    required this.code,
+    required this.nameEs,
+    required this.requiresGym,
+    required this.displayOrder,
+  });
+
+  factory EquipmentType.fromJson(Map<String, dynamic> json) => EquipmentType(
+        code: json['code'] as String,
+        nameEs: (json['nameEs'] as String?) ?? json['code'] as String,
+        requiresGym: (json['requiresGym'] as bool?) ?? false,
+        displayOrder: (json['displayOrder'] as num?)?.toInt() ?? 0,
+      );
+}
+
+/// Algo que el plan no puede cubrir con lo declarado (GET /users/me/plan/limitations).
+class PlanLimitation {
+  final String type;
+  final String code;
+  final String title;
+  final String message;
+
+  /// Codigos que lo resolverian SI el usuario ya los tiene. Nunca una compra obligatoria.
+  final List<String> optionalEquipmentCodes;
+
+  const PlanLimitation({
+    required this.type,
+    required this.code,
+    required this.title,
+    required this.message,
+    required this.optionalEquipmentCodes,
+  });
+
+  factory PlanLimitation.fromJson(Map<String, dynamic> json) => PlanLimitation(
+        type: json['type'] as String,
+        code: json['code'] as String,
+        title: json['title'] as String,
+        message: json['message'] as String,
+        optionalEquipmentCodes:
+            ((json['optionalEquipmentCodes'] as List?) ?? const []).cast<String>(),
+      );
+}
+
+/// El PUT del perfil exige el perfil completo: se parte del GET y solo cambia
+/// equipmentCodes. Los campos de solo lectura del GET no se reenvian.
+Map<String, dynamic> profileUpdateWithEquipment(
+  Map<String, dynamic> profile,
+  List<String> equipmentCodes,
+) {
+  const soloLectura = {'userId', 'birthDate', 'age'};
+  final body = Map<String, dynamic>.from(profile)
+    ..removeWhere((k, _) => soloLectura.contains(k));
+  body['equipmentCodes'] = List<String>.from(equipmentCodes);
+  return body;
+}
+
+/// Orden de presentacion: primero lo que sirve en casa, despues lo de gimnasio.
+List<EquipmentType> sortedForDisplay(List<EquipmentType> types) {
+  final copy = List<EquipmentType>.from(types);
+  copy.sort((a, b) {
+    if (a.requiresGym != b.requiresGym) return a.requiresGym ? 1 : -1;
+    return a.displayOrder.compareTo(b.displayOrder);
+  });
+  return copy;
+}
diff --git a/lib/features/equipment/data/equipment_remote_datasource.dart b/lib/features/equipment/data/equipment_remote_datasource.dart
new file mode 100644
index 0000000..2dbde1a
--- /dev/null
+++ b/lib/features/equipment/data/equipment_remote_datasource.dart
@@ -0,0 +1,41 @@
+import 'package:dio/dio.dart';
+
+import '../../../core/api/api_constants.dart';
+import 'equipment_models.dart';
+
+class EquipmentRemoteDataSource {
+  final Dio _dio;
+
+  const EquipmentRemoteDataSource(this._dio);
+
+  Future<List<EquipmentType>> equipmentTypes() async {
+    final response = await _dio.get(ApiConstants.equipmentTypes);
+    return (response.data as List)
+        .map((e) => EquipmentType.fromJson(e as Map<String, dynamic>))
+        .toList();
+  }
+
+  Future<Map<String, dynamic>> profile() async {
+    final response = await _dio.get(ApiConstants.profile);
+    return Map<String, dynamic>.from(response.data as Map);
+  }
+
+  /// Guarda los codigos y devuelve los que el backend tiene ahora, para
+  /// comprobar que llegaron tal cual.
+  Future<List<String>> saveEquipment(List<String> codes) async {
+    final actual = await profile();
+    final response = await _dio.put(
+      ApiConstants.profile,
+      data: profileUpdateWithEquipment(actual, codes),
+    );
+    return ((response.data as Map)['equipmentCodes'] as List? ?? const [])
+        .cast<String>();
+  }
+
+  Future<List<PlanLimitation>> planLimitations() async {
+    final response = await _dio.get(ApiConstants.planLimitations);
+    return ((response.data as Map)['limitations'] as List? ?? const [])
+        .map((e) => PlanLimitation.fromJson(e as Map<String, dynamic>))
+        .toList();
+  }
+}

+import 'package:dio/dio.dart';
+import 'package:fitsense_mobile/features/equipment/data/equipment_models.dart';
+import 'package:fitsense_mobile/features/equipment/data/equipment_remote_datasource.dart';
+import 'package:fitsense_mobile/features/equipment/presentation/equipment_providers.dart';
+import 'package:fitsense_mobile/features/equipment/presentation/equipment_selection_page.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// Respuesta real de GET /catalog/equipment-types tras V39 (extracto).
+const catalogo = [
+  {'id': 1, 'code': 'body weight', 'nameEs': 'Peso corporal', 'requiresGym': false, 'displayOrder': 1},
+  {'id': 3, 'code': 'band', 'nameEs': 'Banda elástica', 'requiresGym': false, 'displayOrder': 3},
+  {'id': 40, 'code': 'step platform', 'nameEs': 'Step', 'requiresGym': false, 'displayOrder': 30},
+  {'id': 41, 'code': 'wall bars', 'nameEs': 'Espaldera', 'requiresGym': false, 'displayOrder': 32},
+  {'id': 42, 'code': 'anchor point', 'nameEs': 'Punto de anclaje', 'requiresGym': false, 'displayOrder': 33},
+  {'id': 43, 'code': 'ghd bench', 'nameEs': 'Banco GHD', 'requiresGym': true, 'displayOrder': 34},
+];
+
+class FakeDataSource extends EquipmentRemoteDataSource {
+  List<String>? guardado;
+  FakeDataSource() : super(Dio());
+
+  @override
+  Future<List<EquipmentType>> equipmentTypes() async =>
+      catalogo.map(EquipmentType.fromJson).toList();
+
+  @override
+  Future<Map<String, dynamic>> profile() async =>
+      {'userId': 7, 'age': 30, 'equipmentCodes': ['body weight']};
+
+  @override
+  Future<List<String>> saveEquipment(List<String> codes) async => guardado = codes;
+
+  @override
+  Future<List<PlanLimitation>> planLimitations() async => [
+        PlanLimitation.fromJson({
+          'type': 'SLOT',
+          'code': 'UPPER_PULL',
+          'title': 'Ejercicios de tracción',
+          'message': 'Con el equipamiento que indicaste no hay ejercicios de tracción. '
+              'No necesitas comprar nada.',
+          'optionalEquipmentCodes': ['band', 'wall bars', 'anchor point'],
+        })
+      ];
+}
+
+void main() {
+  test('el PUT conserva el perfil, cambia solo equipmentCodes y no reenvia lo de solo lectura', () {
+    final body = profileUpdateWithEquipment(
+      {'userId': 7, 'birthDate': '1990-01-01', 'age': 36, 'goalType': 'GENERAL_FITNESS',
+        'equipmentCodes': ['body weight'], 'allowHangingExercises': false},
+      ['body weight', 'wall bars'],
+    );
+    expect(body.containsKey('userId'), isFalse);
+    expect(body.containsKey('age'), isFalse);
+    expect(body['goalType'], 'GENERAL_FITNESS');
+    expect(body['allowHangingExercises'], isFalse);
+    expect(body['equipmentCodes'], ['body weight', 'wall bars']);
+  });
+
+  test('casa primero y luego gimnasio, por displayOrder', () {
+    final orden = sortedForDisplay(catalogo.reversed.map(EquipmentType.fromJson).toList());
+    expect(orden.last.code, 'ghd bench');
+    expect(orden.first.code, 'body weight');
+  });
+
+  testWidgets('lista los codigos del backend, explica la limitacion y guarda la seleccion',
+      (tester) async {
+    final fake = FakeDataSource();
+    await tester.pumpWidget(ProviderScope(
+      overrides: [equipmentDataSourceProvider.overrideWithValue(fake)],
+      child: const MaterialApp(home: EquipmentSelectionPage()),
+    ));
+    await tester.pumpAndSettle();
+
+    for (final nombre in ['Espaldera', 'Punto de anclaje', 'Banco GHD', 'Step']) {
+      expect(find.text(nombre), findsOneWidget);
+    }
+    expect(find.textContaining('No necesitas comprar nada'), findsOneWidget);
+    expect(find.textContaining('Banda elástica, Espaldera, Punto de anclaje'), findsOneWidget);
+
+    await tester.tap(find.byKey(const ValueKey('equipo-wall bars')));
+    await tester.pump();
+    await tester.scrollUntilVisible(find.text('Guardar'), 200);
+    await tester.tap(find.text('Guardar'));
+    await tester.pumpAndSettle();
+    expect(fake.guardado, ['body weight', 'wall bars']);
+  });
+}

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>pe.fitsense</groupId>
	<artifactId>fitsense-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>FitSense Backend</name>
	<description>FitSense - adaptive AI-generated training plans</description>

	<!-- Elementos vacios (<url/>, <license/>, <developer/>, <scm/>) eliminados:
         no son fatales pero generan warnings en el build y no aportan nada. -->

	<properties>
		<java.version>21</java.version>
		<springdoc.version>3.1.0</springdoc.version>
		<jjwt.version>0.12.6</jjwt.version>
	</properties>

	<dependencies>
		<!-- ============ Core ============ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- ============ Persistencia ============ -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<!-- Obligatorio desde Flyway 10: el soporte de PostgreSQL vive en un modulo aparte -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- ============ Documentacion API ============ -->
		<!-- 3.x es la linea para Boot 4. La 2.5.0 del POM original es para Boot 3
             y falla contra Spring Framework 7 / Jackson 3. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<!-- ============ JWT ============ -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>${jjwt.version}</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>${jjwt.version}</version>
			<scope>runtime</scope>
		</dependency>

		<!-- ============ JSON de las columnas JSONB ============ -->
		<!-- Explicito y con version fija a proposito. El backend usa Jackson para
		     params, input_snapshot, output_snapshot y risk_factors, y esas columnas
		     NO deben depender de que version de Jackson traiga el BOM de Boot: un
		     cambio de linea (2.x -> 3.x, com.fasterxml -> tools.jackson) romperia
		     la lectura de datos ya guardados. -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- ============ Utilidades ============ -->
		<!-- Sin <version>: lo gestiona el BOM de Spring Boot -->
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>

		<!-- OJO: 'pluralize' solo lo necesitas si replicas la estrategia de nombres
             de tablas del proyecto de referencia. Con @Table/@Column explicitos
             (tu decision de diseno) es dependencia muerta: eliminala.
        <dependency>
            <groupId>io.github.encryptorcode</groupId>
            <artifactId>pluralize</artifactId>
            <version>1.0.0</version>
        </dependency>
        -->

		<!-- BLOQUEANTE PENDIENTE: resilience4j-spring-boot3 2.1.0 es de la linea Boot 3.
             Verifica en central.sonatype.com si existe resilience4j-spring-boot4 antes
             de reincorporarlo. Si no existe, no puedes migrar a Boot 4 sin quitar
             circuit breaker / retry o reemplazarlo.
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.1.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>
        -->

		<!-- ============ Desarrollo ============ -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- ============ Test ============ -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- maven-compiler-plugin eliminado: el padre ya lo configura y respeta
                 la propiedad java.version. Fijarlo a mano (3.11.0) solo introduce
                 riesgo de desalineacion. -->

			<!-- SIN <version>: la 3.1.4 del POM original es incompatible con Boot 4
                 y es la causa mas probable del fallo en el IDE. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>